@page
@model QuickStockApp.Pages.Admin.DisabledRoomsModel
@{
    ViewData["Title"] = "Disabled Rooms Management";
}

<div class="rooms-container fade-in">
    <div class="header-section">
        <div class="header-content">
            <a asp-page="/Inventory/Rooms" class="btn btn-link text-decoration-none p-0 mb-2">
                <i class="fas fa-arrow-left me-1"></i> Back to Room Management
            </a>
            <h1 class="premium-title">Disabled Rooms</h1>
            <p class="subtitle">View and manage rooms that are currently out of service.</p>
        </div>
    </div>

    <div class="disabled-rooms-section animate-in">
        <div class="table-container glass-panel" style="border-top: 4px solid #ef4444;">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th>Room Name</th>
                        <th>Floor</th>
                        <th>Description</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DisabledRooms.Any())
                    {
                        @foreach (var room in Model.DisabledRooms)
                        {
                            <tr class="room-row disabled-room">
                                <td>
                                    <div class="room-name-cell">
                                        <div class="room-icon" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                                            <i class="fas fa-door-closed"></i>
                                        </div>
                                        <span class="room-name">@room.RoomName</span>
                                        <span class="status-badge disabled">Disabled</span>
                                    </div>
                                </td>
                                <td><span class="floor-badge">@room.RoomFloor</span></td>
                                <td><span class="description-text">@room.RoomDescription</span></td>
                                <td class="text-right">
                                    <div class="action-btns">
                                        <form asp-page-handler="ToggleStatus" asp-route-roomId="@room.RoomId" method="post" style="display:inline;">
                                            <button type="submit" class="premium-badge-btn enable-btn" style="background: #10b981; min-width: 120px;">
                                                <i class="fas fa-power-off me-1"></i> Enable Room
                                            </button>
                                        </form>
                                        <form asp-page-handler="Delete" asp-route-id="@room.RoomId" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this room permanently?');">
                                            <button type="submit" class="icon-btn delete-btn" title="Delete Room">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="fas fa-check-circle fa-3x mb-3 text-success d-block"></i>
                                No disabled rooms found. All locations are active!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        --glass-bg: rgba(255, 255, 255, 0.7);
        --glass-border: rgba(255, 255, 255, 0.3);
        --text-dark: #1e293b;
    }

    .rooms-container { padding: 2rem; max-width: 1200px; margin: 0 auto; }
    .header-section { margin-bottom: 3rem; }
    .premium-title { font-size: 2.5rem; font-weight: 800; background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .subtitle { color: #64748b; font-size: 1.1rem; }
    .glass-panel { background: var(--glass-bg); backdrop-filter: blur(12px); border: 1px solid var(--glass-border); border-radius: 24px; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05); }
    .premium-table { width: 100%; border-collapse: collapse; }
    .premium-table th { text-align: left; padding: 1.5rem; color: #64748b; font-weight: 600; border-bottom: 1px solid rgba(0,0,0,0.05); }
    .premium-table td { padding: 1.25rem 1.5rem; color: var(--text-dark); border-bottom: 1px solid rgba(0,0,0,0.05); }
    .room-name-cell { display: flex; align-items: center; gap: 1rem; }
    .room-icon { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; }
    .room-name { font-weight: 600; }
    .floor-badge { background: #f1f5f9; padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.85rem; font-weight: 500; color: #475569; }
    .action-btns { display: flex; gap: 0.5rem; justify-content: flex-end; }
    .icon-btn { width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--glass-border); background: white; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; color: #64748b; }
    .delete-btn:hover { background: #ef4444; color: white; border-color: #ef4444; }
    .status-badge { font-size: 0.7rem; padding: 0.2rem 0.5rem; border-radius: 6px; font-weight: 700; text-transform: uppercase; margin-left: 0.5rem; }
    .status-badge.disabled { background: #fee2e2; color: #ef4444; }
    .premium-badge-btn { padding: 0.5rem 1rem; border-radius: 20px; border: none; font-weight: 600; font-size: 0.8rem; cursor: pointer; transition: all 0.3s; color: white; }
    .enable-btn:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2); }
    .text-right { text-align: right; }
    .animate-in { animation: slideUp 0.5s ease-out forwards; }
    @@keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
</style>
