@page
@model QuickStockApp.Pages.Admin.UserManagementModel
@{
    ViewData["Title"] = "User Account Management";
}

<div class="management-container fade-in">
    <div class="header-section mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="premium-title">User Accounts</h1>
            <p class="subtitle">Manage user permissions and campus access levels.</p>
        </div>
        <button class="add-btn animate-in" onclick="openCreateModal()">
            <i class="fas fa-plus me-2"></i> Create New User
        </button>
    </div>

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger glass-panel mb-4 animate-in">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <div class="users-grid animate-in">
        <div class="table-container glass-panel">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th>User Identity</th>
                        <th>Status</th>
                        <th>Role</th>
                        <th>Permissions</th>
                        <th>Campus Access</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr class="user-row @(user.Status == "Disabled" ? "disabled-row" : "")">
                            <td>
                                <div class="user-info-cell">
                                    <div class="avatar-circle">
                                        @user.Username[0].ToString().ToUpper()
                                    </div>
                                    <div class="user-details">
                                        <span class="user-name">@user.FirstName @user.LastName</span>
                                        <span class="user-email">@user.Email (@user.Username)</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="status-badge @user.Status?.ToLower()">@user.Status</span>
                            </td>
                            <td>
                                <span class="role-badge role-@user.Role.ToLower()">@user.Role</span>
                            </td>
                            <td>
                                <div class="permission-badges">
                                    <span class="p-badge @(user.CanAccessITAssets ? "granted" : "denied")" title="IT Assets Access">IT</span>
                                    <span class="p-badge @(user.CanAccessApparel ? "granted" : "denied")" title="Apparel Access">AP</span>
                                </div>
                            </td>
                            <td>
                                <div class="campus-chips">
                                    @foreach (var ac in user.Campuses)
                                    {
                                        <div class="campus-chip @(ac.IsBlocked ? "blocked" : "")">
                                            @ac.Name
                                            <form asp-page-handler="ToggleBlock" asp-route-userId="@user.Id" asp-route-campusId="@ac.CampusId" method="post" style="display:inline;">
                                                <button type="submit" class="chip-btn" title="@(ac.IsBlocked ? "Unblock" : "Block")">
                                                    <i class="fas @(ac.IsBlocked ? "fa-unlock" : "fa-lock")"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    <button class="add-chip-btn" onclick="openAccessModal(@user.Id, '@user.Username')">
                                        <i class="fas fa-plus-circle"></i>
                                    </button>
                                </div>
                            </td>
                            <td class="text-right">
                                <div class="action-btns">
                                    <button class="icon-btn edit-btn" onclick="openEditModal(@user.Id, '@user.Username', '@user.Email', '@user.Role', '@user.FirstName', '@user.LastName', @user.CanAccessITAssets.ToString().ToLower(), @user.CanAccessApparel.ToString().ToLower())" title="Edit User">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <form asp-page-handler="ToggleStatus" asp-route-id="@user.Id" method="post" style="display:inline;">
                                        <button type="submit" class="icon-btn status-btn" title="@(user.Status == "Active" ? "Disable" : "Activate")">
                                            <i class="fas @(user.Status == "Active" ? "fa-user-slash" : "fa-user-check")"></i>
                                        </button>
                                    </form>
                                    <form asp-page-handler="Delete" asp-route-id="@user.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this user permanently?');">
                                        <button type="submit" class="icon-btn delete-btn" title="Delete User">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create User Modal -->
<div id="createModal" class="modal-overlay" style="display: none;">
    <div class="modal-content glass-panel animate-in">
        <div class="modal-header">
            <h2 class="premium-title fs-3">Create Account</h2>
            <button class="close-btn" onclick="closeModal('createModal')">&times;</button>
        </div>
        <form asp-page-handler="Create" method="post" class="mt-3">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">First Name</label>
                    <input asp-for="NewUser.FirstName" class="premium-input" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Last Name</label>
                    <input asp-for="NewUser.LastName" class="premium-input" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Username</label>
                    <input asp-for="NewUser.Username" class="premium-input" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input asp-for="NewUser.Email" type="email" class="premium-input" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Password</label>
                    <input asp-for="NewUser.Password" type="password" class="premium-input" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Role</label>
                    <select asp-for="NewUser.Role" class="premium-input">
                        <option value="User">User</option>
                        <option value="Manager">Manager</option>
                        <option value="Admin">Administrator</option>
                    </select>
                </div>
                <div class="col-12 mt-2">
                    <label class="form-label d-block mb-2 fw-bold">Module Access Access</label>
                    <div class="d-flex gap-4">
                        <div class="form-check">
                            <input asp-for="NewUser.CanAccessITAssets" class="form-check-input" type="checkbox" id="createItAssets" checked>
                            <label class="form-check-label" for="createItAssets">IT Assets</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="NewUser.CanAccessApparel" class="form-check-input" type="checkbox" id="createApparel" checked>
                            <label class="form-check-label" for="createApparel">Apparel Inventory</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer mt-4">
                <button type="button" class="btn btn-secondary" onclick="closeModal('createModal')">Cancel</button>
                <button type="submit" class="btn btn-primary">Create User</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit User Modal -->
<div id="editModal" class="modal-overlay" style="display: none;">
    <div class="modal-content glass-panel">
        <div class="modal-header">
            <h2 class="premium-title fs-3">Edit Account</h2>
            <button class="close-btn" onclick="closeModal('editModal')">&times;</button>
        </div>
        <form asp-page-handler="Edit" method="post" class="mt-3">
            <input type="hidden" id="editUserId" name="id" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">First Name</label>
                    <input asp-for="EditUser.FirstName" id="editFirstName" class="premium-input" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Last Name</label>
                    <input asp-for="EditUser.LastName" id="editLastName" class="premium-input" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Username</label>
                    <input asp-for="EditUser.Username" id="editUsername" class="premium-input" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input asp-for="EditUser.Email" id="editEmail" type="email" class="premium-input" required />
                </div>
                <div class="col-md-12">
                    <label class="form-label">Role</label>
                    <select asp-for="EditUser.Role" id="editRole" class="premium-input">
                        <option value="User">User</option>
                        <option value="Manager">Manager</option>
                        <option value="Admin">Administrator</option>
                    </select>
                </div>
                <div class="col-12 mt-2">
                    <label class="form-label d-block mb-2 fw-bold">Module Access Access</label>
                    <div class="d-flex gap-4">
                        <div class="form-check">
                            <input asp-for="EditUser.CanAccessITAssets" id="editCanAccessITAssets" class="form-check-input" type="checkbox">
                            <label class="form-check-label" for="editCanAccessITAssets">IT Assets Access</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="EditUser.CanAccessApparel" id="editCanAccessApparel" class="form-check-input" type="checkbox">
                            <label class="form-check-label" for="editCanAccessApparel">Apparel Inventory Access</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer mt-4">
                <button type="button" class="btn btn-secondary" onclick="closeModal('editModal')">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<!-- Grant Access Modal -->
<div id="accessModal" class="modal-overlay" style="display: none;">
    <div class="modal-content glass-panel" style="max-width: 400px;">
        <div class="modal-header">
            <h5 class="fw-bold m-0">Grant Campus Access</h5>
            <button class="close-btn" onclick="closeModal('accessModal')">&times;</button>
        </div>
        <form asp-page-handler="GrantAccess" method="post" class="mt-3">
            <input type="hidden" id="accessUserId" name="userId" />
            <div class="mb-3">
                <label class="form-label">Select Campus</label>
                <select name="campusId" class="premium-input">
                    @foreach (var campus in Model.AllCampuses)
                    {
                        <option value="@campus.CampusId">@campus.Name</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary w-100">Grant Access</button>
        </form>
    </div>
</div>

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        --glass-bg: rgba(255, 255, 255, 0.7);
        --glass-border: rgba(255, 255, 255, 0.3);
        --text-dark: #1e293b;
    }

    .management-container { padding: 2rem; max-width: 1300px; margin: 0 auto; }
    .premium-title { font-weight: 800; background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .subtitle { color: #64748b; font-size: 1.1rem; }
    .glass-panel { background: var(--glass-bg); backdrop-filter: blur(12px); border: 1px solid var(--glass-border); border-radius: 20px; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05); }
    .premium-table { width: 100%; border-collapse: collapse; }
    .premium-table th { text-align: left; padding: 1.25rem; color: #64748b; font-weight: 600; border-bottom: 1px solid rgba(0,0,0,0.05); }
    .premium-table td { padding: 1rem 1.25rem; vertical-align: middle; border-bottom: 1px solid rgba(0,0,0,0.05); }
    
    .user-info-cell { display: flex; align-items: center; gap: 1rem; }
    .avatar-circle { width: 40px; height: 40px; border-radius: 50%; background: var(--primary-gradient); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; }
    .user-details { display: flex; flex-direction: column; }
    .user-name { font-weight: 600; color: var(--text-dark); }
    .user-email { font-size: 0.85rem; color: #64748b; }

    .status-badge { padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }
    .status-badge.active { background: #dcfce7; color: #166534; }
    .status-badge.disabled { background: #fee2e2; color: #991b1b; }
    .status-badge.pending { background: #fef9c3; color: #854d0e; }

    .role-badge { padding: 0.25rem 0.75rem; border-radius: 12px; font-size: 0.75rem; font-weight: 600; }
    .role-admin { background: #ede9fe; color: #5b21b6; }
    .role-manager { background: #e0f2fe; color: #075985; }
    .role-user { background: #f1f5f9; color: #475569; }

    .campus-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .campus-chip { background: white; border: 1px solid var(--glass-border); padding: 0.2rem 0.6rem; border-radius: 12px; display: flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; font-weight: 500; }
    .campus-chip.blocked { background: #fee2e2; color: #ef4444; border-color: rgba(239, 68, 68, 0.2); }
    .chip-btn { border: none; background: transparent; padding: 0; color: #64748b; cursor: pointer; display: flex; align-items: center; transition: color 0.2s; }
    .chip-btn:hover { color: var(--text-dark); }
    .add-chip-btn { border: none; background: transparent; color: #6366f1; cursor: pointer; font-size: 1.2rem; display: flex; align-items: center; padding: 0; transition: transform 0.2s; }
    .add-chip-btn:hover { transform: scale(1.1); }

    .permission-badges { display: flex; gap: 0.4rem; }
    .p-badge { width: 24px; height: 24px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 0.65rem; font-weight: 800; cursor: help; }
    .p-badge.granted { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .p-badge.denied { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }

    .action-btns { display: flex; gap: 0.5rem; justify-content: flex-end; }
    .icon-btn { width: 34px; height: 34px; border-radius: 10px; border: 1px solid var(--glass-border); background: white; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; color: #64748b; }
    .icon-btn:hover { background: #f8fafc; color: var(--text-dark); transform: translateY(-2px); }
    .delete-btn:hover { background: #ef4444 !important; color: white !important; }

    .add-btn { padding: 0.75rem 1.5rem; border-radius: 14px; background: var(--primary-gradient); color: white; border: none; font-weight: 600; transition: all 0.3s; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2); }
    .add-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(99, 102, 241, 0.3); }

    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center; z-index: 1000; }
    .modal-content { width: 95%; max-width: 600px; padding: 2rem; position: relative; }
    .close-btn { position: absolute; top: 1.25rem; right: 1.25rem; border: none; background: transparent; font-size: 1.5rem; cursor: pointer; color: #64748b; }
    .premium-input { width: 100%; padding: 0.75rem 1rem; border-radius: 12px; border: 1px solid var(--glass-border); background: rgba(255,255,255,0.8); outline: none; transition: all 0.2s; }
    .premium-input:focus { border-color: #6366f1; box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1); }

    .disabled-row { opacity: 0.7; }
    .fade-in { animation: fadeIn 0.5s ease-out; }
    .animate-in { animation: slideUp 0.5s ease-out forwards; }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script>
    function openCreateModal() {
        document.getElementById('createModal').style.display = 'flex';
    }

    function openEditModal(id, username, email, role, firstName, lastName, canAccessIT, canAccessApparel) {
        document.getElementById('editUserId').value = id;
        document.getElementById('editUsername').value = username;
        document.getElementById('editEmail').value = email;
        document.getElementById('editRole').value = role;
        document.getElementById('editFirstName').value = firstName;
        document.getElementById('editLastName').value = lastName;
        document.getElementById('editCanAccessITAssets').checked = canAccessIT;
        document.getElementById('editCanAccessApparel').checked = canAccessApparel;
        document.getElementById('editModal').style.display = 'flex';
    }

    function openAccessModal(id, username) {
        document.getElementById('accessUserId').value = id;
        document.getElementById('accessModal').style.display = 'flex';
    }

    function closeModal(modalId) {
        document.getElementById(modalId).style.display = 'none';
    }

    // Close on backdrop click
    window.onclick = function(event) {
        if (event.target.className === 'modal-overlay') {
            event.target.style.display = 'none';
        }
    }
</script>
