<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuickStock</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuickStockApp.styles.css" asp-append-version="true" />
    
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        (function() {
            if (localStorage.getItem('theme') === 'dark') {
                document.documentElement.classList.add('dark-mode');
                document.addEventListener('DOMContentLoaded', () => document.body.classList.add('dark-mode'));
            }
        })();
    </script>
</head>
<body class="bg-light">
    @{
        var globalIsAdmin = User.Identity?.IsAuthenticated == true && User.IsInRole("Admin");
        var globalCanIT = User.Identity?.IsAuthenticated == true && (globalIsAdmin || User.FindFirst("CanAccessITAssets")?.Value == "True");
        var globalCanFurniture = User.Identity?.IsAuthenticated == true && (globalIsAdmin || User.FindFirst("CanAccessHomeEconomics")?.Value == "True");
    }

    @if (ViewData["HideNav"] == null || !((bool?)ViewData["HideNav"] ?? false))
    {
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container-fluid px-4">
                <div class="d-flex align-items-center gap-3">
                    <button class="menu-trigger" onclick="toggleDrawer(true)" title="Menu">
                        <i class="fas fa-bars fa-lg"></i>
                    </button>
                    <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="/Dashboard/Index">
                        <div class="brand-icon-box" style="width: 32px; height: 32px; font-size: 0.85rem;">QS</div>
                        <span style="font-weight: 800; font-size: 1.25rem; background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">QuickStock</span>
                    </a>
                </div>

                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var activeCampus = User.FindFirst("ActiveCampusName")?.Value;
                        if (!string.IsNullOrEmpty(activeCampus))
                        {
                            <div class="campus-badge-v2">
                                <i class="fas fa-map-marker-alt"></i>
                                <span>@activeCampus</span>
                                @if (User.IsInRole("Admin") || User.IsInRole("Library Admin") || User.IsInRole("Home Economics Admin"))
                                {
                                    <a asp-page="/Campus/Campuses" class="text-white ms-2 text-decoration-none border-start ps-2" style="opacity: 0.8;" title="Switch Campus">
                                        <i class="fas fa-exchange-alt" style="font-size: 0.8rem;"></i>
                                    </a>
                                }
                            </div>
                        }
                        
                        <div class="vr mx-2 text-muted opacity-25 d-none d-lg-block"></div>
                        
                        <a asp-page="/Account/Profile" class="d-none d-lg-flex align-items-center gap-2 text-decoration-none text-dark hover-opacity-75">
                            <div class="user-avatar-sm">@(User.Identity?.Name?.Substring(0, 1).ToUpper())</div>
                            <div class="d-flex flex-column" style="line-height: 1.1;">
                                <span class="small fw-bold">@User.Identity?.Name</span>
                                <span class="text-muted" style="font-size: 0.7rem;">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                            </div>
                        </a>

                        <div class="ms-3 d-flex gap-2">
                            <div class="position-relative">
                                <button class="btn-navbar-action" id="notificationBell" title="Notifications" data-bs-toggle="dropdown">
                                    <i class="fas fa-bell"></i>
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" id="notificationBadge">0</span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-0" id="notificationDropdown" style="width: 350px; border-radius: 20px; overflow: hidden; margin-top: 10px;">
                                    <div class="p-3 bg-primary text-white d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0 fw-bold">Recent Updates</h6>
                                        <span class="badge bg-white text-primary rounded-pill small" id="notifCountLabel">0 New</span>
                                    </div>
                                    <div id="notificationList" style="max-height: 400px; overflow-y: auto;" class="bg-white">
                                        <div class="p-4 text-center text-muted">
                                            <div class="spinner-border spinner-border-sm mb-2"></div>
                                            <p class="small mb-0">Loading updates...</p>
                                        </div>
                                    </div>
                                    <div class="p-2 border-top text-center bg-light">
                                        <a href="#" class="small text-decoration-none fw-bold text-primary" onclick="clearNotifBadge()">Mark all as read</a>
                                    </div>
                                </div>
                            </div>
                            <a asp-page="/Account/Profile" class="btn-navbar-action" title="My Profile" style="background: var(--primary-gradient); color: white; border: none;"><i class="fas fa-user"></i></a>
                            <button onclick="openSettings()" class="btn-navbar-action" title="Settings" style="background: var(--secondary-color); color: var(--text-dark); border: none;"><i class="fas fa-cog"></i></button>
                            <a asp-page="/Account/Logout" class="btn-navbar-action logout" title="Logout"><i class="fas fa-sign-out-alt"></i></a>
                        </div>
                    }
                    else
                    {
                        <a asp-page="/Account/Login" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">Login</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="drawer-overlay" id="drawerOverlay" onclick="toggleDrawer(false)"></div>
    <div class="side-drawer" id="sideDrawer">
        <div class="drawer-header">
            <div class="d-flex align-items-center gap-2">
                <div class="brand-icon-box">QS</div>
                <span class="fs-4 fw-800 gradient-text">QuickStock</span>
            </div>
            <button class="btn-close-premium" onclick="toggleDrawer(false)"><i class="fas fa-times"></i></button>
        </div>
        
        <div class="drawer-nav">
            <div class="drawer-section-label">Main</div>
            <a href="/Dashboard/Index" class="drawer-link @(ViewData["Title"]?.ToString() == "Home" ? "active" : "")"><i class="fas fa-th-large"></i> Dashboard</a>
            <a href="/Account/Profile" class="drawer-link @(ViewData["Title"]?.ToString() == "My Profile" ? "active" : "")"><i class="fas fa-user-circle"></i> My Profile</a>

            @{
                var isLibraryAdmin = User.IsInRole("Library Admin");
                var isFurnitureAdmin = User.IsInRole("Home Economics Admin");
                var canAccessApparel = globalIsAdmin || (User.FindFirst("CanAccessApparel")?.Value == "True");
                var canAccessLibrary = globalIsAdmin || isLibraryAdmin || (User.FindFirst("CanAccessLibrary")?.Value == "True");
                var canAccessAdmin = globalIsAdmin || isLibraryAdmin || isFurnitureAdmin;
            }

            @if (globalCanIT || globalCanFurniture) { <div class="drawer-section-label">Inventory &amp; Assets</div> }
            @if (globalCanIT)
            {
                <a href="/Inventory/ItAssets" class="drawer-link @(ViewData["Title"]?.ToString() == "IT Assets" ? "active" : "")"><i class="fas fa-laptop"></i> IT Assets</a>
                <a href="/Inventory/Rooms" class="drawer-link @(ViewData["Title"]?.ToString() == "Room Management" ? "active" : "")"><i class="fas fa-door-open"></i> Room Management</a>
            }
            @if (globalCanFurniture)
            {
                <a href="/Inventory/Furniture" class="drawer-link @(ViewData["Title"]?.ToString() == "Furniture Inventory" ? "active" : "")"><i class="fas fa-couch"></i> Furniture Inventory</a>
            }
            
            @{
                var canAccessConsumables = globalIsAdmin || (User.FindFirst("CanAccessConsumables")?.Value == "True");
            }
            @if (canAccessConsumables)
            {
                <a href="/Inventory/Consumables" class="drawer-link @(ViewData["Title"]?.ToString() == "Consumable Inventory" ? "active" : "")"><i class="fas fa-box-open"></i> Consumable Inventory</a>
                <a href="/Inventory/ConsumableRequests" class="drawer-link @(ViewData["Title"]?.ToString() == "Consumables Requests" ? "active" : "")"><i class="fas fa-file-signature"></i> Consumable Requests</a>
                <a href="/Inventory/ConsumableLogs" class="drawer-link @(ViewData["Title"]?.ToString() == "Consumables Activity Logs" ? "active" : "")"><i class="fas fa-history"></i> Consumable Logs</a>
            }

            @if (canAccessApparel)
            {
                <div class="drawer-section-label">Apparel</div>
                <a href="/Inventory/ApparelList" class="drawer-link @(ViewData["Title"]?.ToString() == "Apparel Inventory" ? "active" : "")"><i class="fas fa-tshirt"></i> Apparel List</a>
                <a href="/Inventory/SoldApparel" class="drawer-link @(ViewData["Title"]?.ToString() == "Sold Apparel" ? "active" : "")"><i class="fas fa-receipt"></i> Sales History</a>
            }

            @if (canAccessLibrary)
            {
                <div class="drawer-section-label">Resources</div>
                <a href="/Community/Library" class="drawer-link @(ViewData["Title"]?.ToString() == "Library" ? "active" : "")"><i class="fas fa-book"></i> Library Explorer</a>
            }

            <div class="drawer-section-label">System</div>
            <a href="/Campus/Campuses" class="drawer-link @(ViewData["Title"]?.ToString() == "Campuses" ? "active" : "")"><i class="fas fa-building"></i> Campuses</a>

            @if (canAccessAdmin)
            {
                <div class="drawer-section-label">Administration</div>
                <a href="/Admin/UserManagement" class="drawer-link @(ViewData["Title"]?.ToString() == "User Account Management" ? "active" : "")"><i class="fas fa-users-cog"></i> Account Management</a>
                <a href="/Account/Register" class="drawer-link"><i class="fas fa-user-plus"></i> Register User</a>
            }
        </div>
    </div>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        async function loadNotifications() {
            try {
                const response = await fetch('/Dashboard/Index?handler=Notifications');
                if (!response.ok) {
                    const listEl = document.getElementById('notificationList');
                    if (listEl) {
                        listEl.innerHTML = `
                            <div class="p-4 text-center text-muted">
                                <p class="small mb-0">Unable to load updates.</p>
                            </div>`;
                    }
                    return;
                }
                const notifs = await response.json();
                
                const listEl = document.getElementById('notificationList');
                const badgeEl = document.getElementById('notificationBadge');
                const labelEl = document.getElementById('notifCountLabel');
                
                if (!listEl) return;
                
                if (!notifs || notifs.length === 0) {
                    listEl.innerHTML = `
                        <div class="p-4 text-center text-muted">
                            <i class="fas fa-check-double mb-2 text-success" style="font-size: 1.5rem;"></i>
                            <p class="small mb-0 fw-semibold text-slate-800">You're all caught up!</p>
                            <p class="text-slate-400" style="font-size: 0.75rem;">No new activity or request updates found.</p>
                        </div>`;
                    if (badgeEl) badgeEl.classList.add('d-none');
                    if (labelEl) labelEl.innerText = "0 New";
                    return;
                }
                
                const readNotifIds = JSON.parse(localStorage.getItem('readConsumableNotifIds') || '[]');
                const unreadCount = notifs.filter(n => !readNotifIds.includes(n.id)).length;
                
                if (badgeEl) {
                    if (unreadCount > 0) {
                        badgeEl.innerText = unreadCount;
                        badgeEl.classList.remove('d-none');
                    } else {
                        badgeEl.classList.add('d-none');
                    }
                }
                if (labelEl) {
                    labelEl.innerText = `${unreadCount} New`;
                }
                
                listEl.innerHTML = '';
                notifs.forEach(notif => {
                    const isUnread = !readNotifIds.includes(notif.id);
                    const isApproved = notif.status === 'Approved';
                    const isRejected = notif.status === 'Rejected';
                    
                    let statusIcon = '<div class="rounded-circle bg-warning text-white d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; flex-shrink: 0;"><i class="fas fa-hourglass-half" style="font-size: 0.85rem;"></i></div>';
                    if (isApproved) {
                        statusIcon = '<div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; flex-shrink: 0;"><i class="fas fa-check" style="font-size: 0.85rem;"></i></div>';
                    } else if (isRejected) {
                        statusIcon = '<div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; flex-shrink: 0;"><i class="fas fa-times" style="font-size: 0.85rem;"></i></div>';
                    }
                    
                    const itemEl = document.createElement('a');
                    itemEl.href = notif.url || '#';
                    itemEl.className = `dropdown-item p-3 border-bottom d-flex align-items-start gap-3 hover-bg-slate-50 transition-all ${isUnread ? 'bg-light-blue fw-semibold' : ''}`;
                    itemEl.style.whiteSpace = 'normal';
                    itemEl.style.cursor = 'pointer';
                    
                    // Format nice human-readable relative time
                    const dateVal = new Date(notif.timestamp);
                    const formattedTime = dateVal.toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
                    
                    itemEl.innerHTML = `
                        ${statusIcon}
                        <div class="flex-grow-1" style="min-width: 0;">
                            <div class="d-flex justify-content-between align-items-baseline mb-1">
                                <span class="small fw-bold text-dark text-truncate" style="font-size: 0.85rem;">${notif.title}</span>
                                <span class="text-muted" style="font-size: 0.7rem; flex-shrink: 0; margin-left: 8px;">${formattedTime}</span>
                            </div>
                            <p class="text-secondary mb-0 text-break" style="font-size: 0.78rem; line-height: 1.35;">${notif.message}</p>
                        </div>
                    `;
                    
                    itemEl.addEventListener('click', (e) => {
                        markAsRead(notif.id);
                    });
                    
                    listEl.appendChild(itemEl);
                });
            } catch (err) {
                console.error("Error loading notifications: ", err);
            }
        }

        function markAsRead(id) {
            const readNotifIds = JSON.parse(localStorage.getItem('readConsumableNotifIds') || '[]');
            if (!readNotifIds.includes(id)) {
                readNotifIds.push(id);
                localStorage.setItem('readConsumableNotifIds', JSON.stringify(readNotifIds));
            }
            loadNotifications();
        }

        function clearNotifBadge() {
            const readNotifIds = JSON.parse(localStorage.getItem('readConsumableNotifIds') || '[]');
            fetch('/Dashboard/Index?handler=Notifications')
                .then(r => r.ok ? r.json() : [])
                .then(notifs => {
                    notifs.forEach(n => {
                        if (!readNotifIds.includes(n.id)) {
                            readNotifIds.push(n.id);
                        }
                    });
                    localStorage.setItem('readConsumableNotifIds', JSON.stringify(readNotifIds));
                    loadNotifications();
                })
                .catch(err => console.error(err));
        }

        // Auto load notifications when DOM loads
        if (document.getElementById('notificationBell')) {
            document.addEventListener('DOMContentLoaded', () => {
                loadNotifications();
                // Poll every 30 seconds for live updates
                setInterval(loadNotifications, 30000);
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>