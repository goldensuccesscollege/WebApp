@page
@model QuickStockApp.Pages.VerifyModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Verify Account";
}

<div class="login-wrapper">
    <div class="login-card glass-card shadow-lg">
        <div class="card-body p-4 p-md-5 text-center">
            <div id="loadingSection">
                <div class="spinner-border text-primary mb-3" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="text-muted">Processing your verification...</p>
            </div>

            <div id="manualSection" class="d-none">
                <div class="mb-4">
                    <div class="stat-icon-wrapper d-flex align-items-center justify-content-center rounded-circle bg-primary-light mx-auto" style="width: 70px; height: 70px;">
                        <i class="fas fa-shield-alt fa-2x text-primary"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-3">Verify Your Account</h3>
                <p class="text-muted small mb-4">Didn't click the link? Paste your verification token below.</p>
                
                <form id="verifyForm">
                    <div class="form-floating mb-3">
                        <input type="text" id="tokenInput" class="form-control" placeholder="Token" required>
                        <label for="tokenInput">Verification Token</label>
                    </div>
                    <button type="button" onclick="manualVerify()" class="btn btn-primary btn-lg w-100 rounded-pill shadow-sm py-3 fw-bold">
                        Verify Now
                    </button>
                </form>
            </div>

            <div id="resultSection" class="d-none mt-4">
                <div id="resultIcon" class="mb-3"></div>
                <h4 id="resultTitle" class="fw-bold"></h4>
                <p id="resultMsg" class="text-muted"></p>
                <div class="mt-4">
                    <a href="/Account/Login" class="btn btn-outline-primary rounded-pill px-4">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .login-wrapper {
        width: 100%;
        max-width: 450px;
        margin: auto;
        padding: 1rem;
    }

    .login-card {
        border: none;
        border-radius: 24px;
        overflow: hidden;
    }

    .bg-primary-light { background-color: rgba(99, 102, 241, 0.1); }
    
    .text-success-custom { color: #10b981; }
    .text-danger-custom { color: #ef4444; }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const urlParams = new URLSearchParams(window.location.search);
            const token = urlParams.get('token');

            if (token) {
                await verifyToken(token);
            } else {
                showManualSection();
            }
        });

        function showManualSection() {
            document.getElementById('loadingSection').classList.add('d-none');
            document.getElementById('manualSection').classList.remove('d-none');
        }

        async function manualVerify() {
            const token = document.getElementById('tokenInput').value.trim();
            if (token) await verifyToken(token);
        }

        async function verifyToken(token) {
            document.getElementById('loadingSection').classList.remove('d-none');
            document.getElementById('manualSection').classList.add('d-none');
            document.getElementById('resultSection').classList.add('d-none');

            try {
                const response = await fetch(`?handler=VerifyJson&token=${encodeURIComponent(token)}`);
                const result = await response.json();
                showResult(result.success, result.message);
            } catch (error) {
                showResult(false, "Connection error. Please try again.");
            }
        }

        function showResult(success, message) {
            document.getElementById('loadingSection').classList.add('d-none');
            document.getElementById('manualSection').classList.add('d-none');
            const section = document.getElementById('resultSection');
            const icon = document.getElementById('resultIcon');
            const title = document.getElementById('resultTitle');
            const msg = document.getElementById('resultMsg');

            section.classList.remove('d-none');
            title.textContent = success ? "Success!" : "Verification Failed";
            title.className = success ? "fw-bold text-success-custom" : "fw-bold text-danger-custom";
            msg.textContent = message;
            icon.innerHTML = success 
                ? '<i class="fas fa-check-circle fa-4x text-success-custom"></i>' 
                : '<i class="fas fa-times-circle fa-4x text-danger-custom"></i>';

            if (success) {
                setTimeout(() => {
                    window.location.href = '/Account/Login';
                }, 3000);
            }
        }
    </script>
}
