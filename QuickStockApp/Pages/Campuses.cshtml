@page
@model QuickStockApp.Pages.CampusesModel
@{
    ViewData["Title"] = "Campuses";
    ViewData["HideNav"] = true;
}

<div class="campus-container animate-fade-in">
    <div class="glass-header">
        <div class="header-content">
            <h1><i class="fas fa-university"></i> Campus Explorer</h1>
            <p>Select a campus to manage its assets and rooms</p>
        </div>
        @if (Model.UserRole == "Admin")
        {
            <button class="btn-primary" onclick="openModal('add')">
                <i class="fas fa-plus"></i> Add New Campus
            </button>
        }
    </div>


    <div class="campus-grid">
        @foreach (var campus in Model.Campuses)
        {
            <div class="campus-card glass-panel @(Model.AssignedCampusId == campus.CampusId ? "assigned" : "")">
                <div class="card-status">
                    @if (Model.AssignedCampusId == campus.CampusId)
                    {
                        <span class="badge-assigned"><i class="fas fa-check-circle"></i> Assigned</span>
                    }
                </div>
                <div class="card-icon">
                    <i class="fas fa-building"></i>
                </div>
                <div class="card-body">
                    <h3>@campus.Name</h3>
                    <p class="address"><i class="fas fa-map-marker-alt"></i> @campus.Address</p>
                    <p class="description">@campus.Description</p>
                </div>
                <div class="card-footer">
                    <form asp-page-handler="SelectCampus" method="post">
                        <input type="hidden" name="id" value="@campus.CampusId" />
                        <button type="submit" class="btn-explore">
                            Explore <i class="fas fa-arrow-right"></i>
                        </button>
                    </form>
                    @if (Model.UserRole == "Admin")
                    {
                        <div class="admin-actions">
                            <button class="btn-icon" title="Edit" onclick="editCampus(@Json.Serialize(campus))">
                                <i class="fas fa-edit"></i>
                            </button>
                            <form asp-page-handler="Delete" method="post" onsubmit="return confirm('Delete this campus? This will affect linked rooms and assets.')">
                                <input type="hidden" name="id" value="@campus.CampusId" />
                                <button type="submit" class="btn-icon delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Add/Edit Modal -->
<div id="campusModal" class="modal-overlay">
    <div class="modal-content glass-panel">
        <div class="modal-header">
            <h2 id="modalTitle">Add New Campus</h2>
            <button class="close-btn" onclick="closeModal()">&times;</button>
        </div>
        <form method="post" id="campusForm">
            <input type="hidden" asp-for="Campus.CampusId" id="campusId" />
            <div class="modal-body">
                <div class="form-group">
                    <label asp-for="Campus.Name">Campus Name</label>
                    <input asp-for="Campus.Name" id="campusName" placeholder="e.g., Cebu Campus" required />
                </div>
                <div class="form-group">
                    <label asp-for="Campus.Address">Address</label>
                    <input asp-for="Campus.Address" id="campusAddress" placeholder="e.g., Cebu City, Philippines" />
                </div>
                <div class="form-group">
                    <label asp-for="Campus.Description">Description</label>
                    <textarea asp-for="Campus.Description" id="campusDesc" rows="3" placeholder="Additional details..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" onclick="closeModal()">Cancel</button>
                <button type="submit" class="btn-primary" id="submitBtn" asp-page-handler="Add">Create Campus</button>
            </div>
        </form>
    </div>
</div>

<style>
    :root {
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --glass-bg: rgba(255, 255, 255, 0.7);
        --glass-border: rgba(255, 255, 255, 0.3);
        --text-main: #1f2937;
        --text-muted: #6b7280;
    }

    .animate-fade-in {
        animation: fadeIn 0.6s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .campus-container {
        padding: 2rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .glass-header {
        background: var(--glass-bg);
        backdrop-filter: blur(12px);
        border: 1px solid var(--glass-border);
        padding: 2rem;
        border-radius: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 3rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
    }

    .header-content h1 {
        font-size: 2rem;
        color: var(--text-main);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .header-content p {
        color: var(--text-muted);
        margin: 0.25rem 0 0 0;
    }

    .campus-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2rem;
    }

    .glass-panel {
        background: var(--glass-bg);
        backdrop-filter: blur(12px);
        border: 1px solid var(--glass-border);
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
    }

    .campus-card {
        border-radius: 24px;
        padding: 2rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
    }

    .campus-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 48px rgba(79, 70, 229, 0.15);
        border-color: rgba(79, 70, 229, 0.3);
    }

    .campus-card.assigned {
        border: 2px solid var(--primary);
    }

    .card-status {
        position: absolute;
        top: 1rem;
        right: 1rem;
    }

    .badge-assigned {
        background: rgba(79, 70, 229, 0.1);
        color: var(--primary);
        padding: 0.4rem 0.8rem;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .card-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, var(--primary), #818cf8);
        color: white;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 8px 16px rgba(79, 70, 229, 0.2);
    }

    .card-body h3 {
        font-size: 1.4rem;
        margin: 0 0 0.5rem 0;
        color: var(--text-main);
    }

    .address {
        color: var(--text-muted);
        font-size: 0.9rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .description {
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.5;
        flex-grow: 1;
    }

    .card-footer {
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--glass-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-explore {
        background: var(--primary);
        color: white;
        padding: 0.6rem 1.4rem;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s;
    }

    .btn-explore:hover {
        background: var(--primary-hover);
        transform: translateX(4px);
    }

    .admin-actions {
        display: flex;
        gap: 0.5rem;
    }

    .btn-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        border: 1px solid var(--glass-border);
        background: white;
        color: var(--text-muted);
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-icon:hover {
        background: #f3f4f6;
        color: var(--primary);
        border-color: var(--primary);
    }

    .btn-icon.delete:hover {
        color: #ef4444;
        border-color: #ef4444;
    }

    /* Modal Styles */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(4px);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal-content {
        width: 90%;
        max-width: 500px;
        border-radius: 24px;
        padding: 2rem;
        animation: modalScale 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @@keyframes modalScale {
        from { transform: scale(0.9); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 500;
        color: var(--text-main);
    }

    .form-group input, .form-group textarea {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1px solid var(--glass-border);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.5);
        outline: none;
        transition: border-color 0.2s;
    }

    .form-group input:focus, .form-group textarea:focus {
        border-color: var(--primary);
    }

    .btn-primary {
        background: var(--primary);
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

    .btn-primary:hover {
        background: var(--primary-hover);
    }

    .btn-secondary {
        background: transparent;
        color: var(--text-muted);
        border: 1px solid var(--glass-border);
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
        font-weight: 600;
        cursor: pointer;
    }
</style>

<script>
    function openModal(mode) {
        const modal = document.getElementById('campusModal');
        const title = document.getElementById('modalTitle');
        const submitBtn = document.getElementById('submitBtn');
        const form = document.getElementById('campusForm');

        if (mode === 'add') {
            title.innerText = 'Add New Campus';
            submitBtn.innerText = 'Create Campus';
            submitBtn.setAttribute('asp-page-handler', 'Add');
            form.action = '?handler=Add';
            document.getElementById('campusId').value = '0';
            document.getElementById('campusName').value = '';
            document.getElementById('campusAddress').value = '';
            document.getElementById('campusDesc').value = '';
        }

        modal.style.display = 'flex';
    }

    function closeModal() {
        document.getElementById('campusModal').style.display = 'none';
    }

    function editCampus(campus) {
        const modal = document.getElementById('campusModal');
        const title = document.getElementById('modalTitle');
        const submitBtn = document.getElementById('submitBtn');
        const form = document.getElementById('campusForm');

        title.innerText = 'Edit Campus';
        submitBtn.innerText = 'Save Changes';
        submitBtn.setAttribute('asp-page-handler', 'Update');
        form.action = '?handler=Update';

        document.getElementById('campusId').value = campus.campusId;
        document.getElementById('campusName').value = campus.name;
        document.getElementById('campusAddress').value = campus.address || '';
        document.getElementById('campusDesc').value = campus.description || '';

        modal.style.display = 'flex';
    }

    // Close on outside click
    window.onclick = function(event) {
        const modal = document.getElementById('campusModal');
        if (event.target == modal) {
            closeModal();
        }
    }
</script>
