@section Scripts {
    <script>
        window.isStaffUser = @(isStaff ? "true" : "false");
        window.currentActiveStock = 0;
        window.isAdditionMode = true;
        window.currentTypeFilter = 'All';
        window.currentSearchQuery = '';
        window.showOnlyLowStock = false;

        function openCreateModal() {
            var createModal = new bootstrap.Modal(document.getElementById('createConsumableModal'));
            createModal.show();
        }

        document.addEventListener("DOMContentLoaded", function () {
            // Enable tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });

            // Set up search event listener
            document.getElementById('tableSearchInput').addEventListener('input', function(e) {
                window.currentSearchQuery = e.target.value.toLowerCase().trim();
                applyFilters();
            });

            // Set up input change event listener for live balance preview
            document.getElementById('inputQuantityDelta').addEventListener('input', function() {
                // Ensure value is clean
                let val = parseInt(this.value, 10);
                if (isNaN(val) || val < 1) {
                    val = 1;
                }
                this.value = val;
                updateBalancePreview();
            });
        });

        // Client-side search and filters
        function applyFilters() {
            const rows = document.querySelectorAll('.consumable-row');
            let matchedCount = 0;
            
            rows.forEach(row => {
                const name = row.getAttribute('data-product-name').toLowerCase();
                const type = row.getAttribute('data-product-type');
                const count = parseInt(row.getAttribute('data-count') || '0', 10);
                
                const matchesSearch = name.includes(window.currentSearchQuery) || type.toLowerCase().includes(window.currentSearchQuery);
                const matchesType = (window.currentTypeFilter === 'All' || type === window.currentTypeFilter);
                const matchesLowStock = (!window.showOnlyLowStock || count <= 5);
                
                if (matchesSearch && matchesType && matchesLowStock) {
                    row.style.display = '';
                    matchedCount++;
                } else {
                    row.style.display = 'none';
                }
            });
            
            // Show/hide empty state row if everything is filtered out
            const tableBody = document.getElementById('consumablesTableBody');
            const existingEmptyMsg = document.getElementById('noResultsRow');
            
            if (matchedCount === 0 && rows.length > 0) {
                if (!existingEmptyMsg) {
                    const emptyTr = document.createElement('tr');
                    emptyTr.id = 'noResultsRow';
                    emptyTr.className = 'border-0';
                    emptyTr.innerHTML = `
                        <td colspan="5" class="text-center py-5 text-slate-400">
                            <div class="py-4 d-flex flex-column align-items-center">
                                <div class="rounded-circle bg-slate-100 d-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">
                                    <i class="bi bi-search fs-5 text-slate-500"></i>
                                </div>
                                <span class="fw-semibold text-slate-900 d-block fs-6 mb-1">No results found</span>
                                <span class="small text-slate-500">Your search did not return any matches. Try adjusting your keyword or filters.</span>
                            </div>
                        </td>
                    `;
                    tableBody.appendChild(emptyTr);
                }
            } else if (existingEmptyMsg) {
                existingEmptyMsg.remove();
            }
        }

        function toggleLowStockFilter(card) {
            window.showOnlyLowStock = !window.showOnlyLowStock;
            
            if (window.showOnlyLowStock) {
                card.classList.add('low-stock-active');
            } else {
                card.classList.remove('low-stock-active');
            }
            
            applyFilters();
        }

        function filterByProductType(type, button) {
            window.currentTypeFilter = type;
            
            // Toggle active classes on filter buttons
            const filterContainer = button.parentElement;
            const buttons = filterContainer.querySelectorAll('.saas-btn-filter');
            buttons.forEach(btn => {
                btn.classList.remove('active');
            });
            button.classList.add('active');
            
            applyFilters();
        }

        // Modal triggers and handlers
        function launchMutationModal(id, name, currentCount, isAdding) {
            window.currentActiveStock = parseInt(currentCount, 10);
            
            document.getElementById('hiddenItemId').value = id;
            document.getElementById('modalTargetLabel').innerText = name;
            
            const inputField = document.getElementById('inputQuantityDelta');
            inputField.value = "1";
            
            setModalMode(isAdding);
            
            var operationModal = new bootstrap.Modal(document.getElementById('mutationTransactionModal'));
            operationModal.show();
        }

        function setModalMode(isAdding) {
            window.isAdditionMode = isAdding;
            
            const formElement = document.getElementById('mutationForm');
            const headerBanner = document.getElementById('modalHeaderBanner');
            const submitBtn = document.getElementById('modalSubmitButton');
            const titleText = document.getElementById('modalTitleText');
            
            const toggleIn = document.getElementById('toggleInBtn');
            const toggleOut = document.getElementById('toggleOutBtn');
            
            const inputField = document.getElementById('inputQuantityDelta');
            
            // Clear validation states
            inputField.classList.remove('is-invalid');
            document.getElementById('clientValidationErrorMsg').style.display = 'none';

            if (isAdding) {
                formElement.action = '?handler=AddStock';
                headerBanner.className = 'modal-header border-0 bg-success text-white py-3 transition-all';
                submitBtn.className = 'btn px-4 py-2 rounded-pill fw-bold btn-success text-white border-0 shadow-sm';
                submitBtn.innerText = window.isStaffUser ? 'Submit Addition Request' : 'Apply Stock Addition';
                titleText.innerHTML = window.isStaffUser ? '<i class="bi bi-box-arrow-in-down"></i> Request Stock Addition' : '<i class="bi bi-box-arrow-in-down"></i> Add Inventory Stock';
                
                toggleIn.className = 'btn flex-fill py-2 rounded-2 fw-bold d-flex align-items-center justify-content-center gap-2 border-0 transaction-mode-btn active-in';
                toggleOut.className = 'btn flex-fill py-2 rounded-2 fw-bold d-flex align-items-center justify-content-center gap-2 border-0 transaction-mode-btn';
                
                inputField.removeAttribute('max');
            } else {
                formElement.action = '?handler=DeductStock';
                headerBanner.className = 'modal-header border-0 bg-danger text-white py-3 transition-all';
                submitBtn.className = 'btn px-4 py-2 rounded-pill fw-bold btn-danger text-white border-0 shadow-sm';
                submitBtn.innerText = window.isStaffUser ? 'Submit Deduction Request' : 'Apply Stock Deduction';
                titleText.innerHTML = window.isStaffUser ? '<i class="bi bi-box-arrow-up"></i> Request Stock Deduction' : '<i class="bi bi-box-arrow-up"></i> Deduct Inventory Stock';
                
                toggleIn.className = 'btn flex-fill py-2 rounded-2 fw-bold d-flex align-items-center justify-content-center gap-2 border-0 transaction-mode-btn';
                toggleOut.className = 'btn flex-fill py-2 rounded-2 fw-bold d-flex align-items-center justify-content-center gap-2 border-0 transaction-mode-btn active-out';
                
                inputField.max = window.currentActiveStock;
            }
            
            updateBalancePreview();
        }

        // Live calculations inside spinner
        function adjustDelta(amount) {
            const inputField = document.getElementById('inputQuantityDelta');
            let currentVal = parseInt(inputField.value, 10);
            if (isNaN(currentVal)) {
                currentVal = 1;
            }
            
            let newVal = currentVal + amount;
            if (newVal < 1) {
                newVal = 1;
            }
            
            // Limit deductions to maximum available stock if in deduct mode
            if (!window.isAdditionMode && newVal > window.currentActiveStock) {
                newVal = window.currentActiveStock;
            }
            
            inputField.value = newVal;
            updateBalancePreview();
        }

        function updateBalancePreview() {
            const inputField = document.getElementById('inputQuantityDelta');
            const previewCurrent = document.getElementById('previewCurrentStock');
            const previewOperator = document.getElementById('previewOperatorIcon');
            const previewAdjustmentLabel = document.getElementById('previewAdjustmentLabel');
            const previewAdjustmentValue = document.getElementById('previewAdjustmentValue');
            const previewNew = document.getElementById('previewNewStock');
            const warningHint = document.getElementById('allocationWarningHint');
            const submitBtn = document.getElementById('modalSubmitButton');
            const errorContainer = document.getElementById('clientValidationErrorMsg');
            
            const delta = parseInt(inputField.value, 10) || 0;
            previewCurrent.innerText = window.currentActiveStock;
            
            inputField.classList.remove('is-invalid');
            errorContainer.style.display = 'none';
            submitBtn.disabled = false;

            if (window.isAdditionMode) {
                const newStock = window.currentActiveStock + delta;
                
                previewOperator.className = 'bi bi-plus-lg fs-5 text-success';
                previewAdjustmentLabel.innerText = 'Adding';
                previewAdjustmentLabel.className = 'd-block text-success small text-uppercase tracking-wider fw-bold mb-1';
                previewAdjustmentValue.innerText = `+${delta}`;
                previewAdjustmentValue.className = 'fw-800 fs-4 text-success';
                
                previewNew.innerText = newStock;
                previewNew.className = 'fw-800 fs-3 text-success';
                
                warningHint.innerHTML = `<span class="text-success fw-semibold"><i class="bi bi-info-circle-fill me-1"></i> Augmented quantity will become <strong>${newStock}</strong> units.</span>`;
            } else {
                const newStock = window.currentActiveStock - delta;
                
                previewOperator.className = 'bi bi-dash-lg fs-5 text-danger';
                previewAdjustmentLabel.innerText = 'Deducting';
                previewAdjustmentLabel.className = 'd-block text-danger small text-uppercase tracking-wider fw-bold mb-1';
                previewAdjustmentValue.innerText = `-${delta}`;
                previewAdjustmentValue.className = 'fw-800 fs-4 text-danger';
                
                previewNew.innerText = newStock >= 0 ? newStock : 0;
                
                if (newStock < 0) {
                    previewNew.className = 'fw-800 fs-3 text-danger animate-pulse';
                    inputField.classList.add('is-invalid');
                    errorContainer.innerText = `Exceeds current stock capacity of ${window.currentActiveStock} items.`;
                    errorContainer.style.display = 'block';
                    submitBtn.disabled = true;
                    warningHint.innerHTML = `<span class="text-danger fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i> Error: Insufficient stock available.</span>`;
                } else {
                    previewNew.className = 'fw-800 fs-3 text-danger';
                    warningHint.innerHTML = `<span class="text-danger fw-semibold"><i class="bi bi-info-circle-fill me-1"></i> Reduced quantity will become <strong>${newStock}</strong> units.</span>`;
                }
            }
        }

        // Form submission checks
        document.getElementById('mutationForm').addEventListener('submit', function (event) {
            const inputField = document.getElementById('inputQuantityDelta');
            const errorContainer = document.getElementById('clientValidationErrorMsg');
            const val = parseInt(inputField.value, 10);

            if (isNaN(val) || val <= 0) {
                event.preventDefault();
                inputField.classList.add('is-invalid');
                errorContainer.innerText = "Value must be a valid count greater than zero.";
                errorContainer.style.display = 'block';
                return false;
            }

            if (!window.isAdditionMode && val > window.currentActiveStock) {
                event.preventDefault();
                inputField.classList.add('is-invalid');
                errorContainer.innerText = `Cannot deduct ${val} units. Only ${window.currentActiveStock} items are currently available.`;
                errorContainer.style.display = 'block';
                return false;
            }
        });
    </script>
}