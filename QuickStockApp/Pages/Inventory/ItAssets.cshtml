<script>
    // ---- IT Assets Mini Dashboard ----
    const _itCampusId = "@(User.FindFirst("ActiveCampusId")?.Value)";
    const _canSeeLogsReports = @(canSeeLogsReports ? "true" : "false");
    const PALETTE = ['#6366f1','#10b981','#f59e0b','#ec4899','#3b82f6','#8b5cf6','#ef4444','#14b8a6'];

    let itDashVisible = true;
    function toggleDashboard() {
        const content = document.getElementById('itDashContent');
        const icon = document.getElementById('dashToggleIcon');
        itDashVisible = !itDashVisible;
        content.style.display = itDashVisible ? '' : 'none';
        icon.className = itDashVisible ? 'fas fa-chevron-up' : 'fas fa-chevron-down';
    }

    async function loadItDashboard() {
        if (!_itCampusId) return;
        try {
            const res = await fetch(`?handler=Stats&campusId=${_itCampusId}`);
            if (!res.ok) return;
            const data = await res.json();

            // Stat cards
            const statuses = data.assetsByStatus || [];
            const total = statuses.reduce((s, x) => s + x.count, 0);
            const working = (statuses.find(x => x.status === 'Working') || {}).count || 0;
            const broken = (statuses.find(x => x.status === 'Broken') || {}).count || 0;
            const maintenance = (statuses.find(x => x.status === 'UnderMaintenance') || {}).count || 0;

            document.getElementById('stat-total').textContent = total;
            document.getElementById('stat-working').textContent = working;
            document.getElementById('stat-broken').textContent = broken;
            document.getElementById('stat-maintenance').textContent = maintenance;

            // Status doughnut chart
            if (statuses.length) {
                new Chart(document.getElementById('itStatusChart'), {
                    type: 'doughnut',
                    data: {
                        labels: statuses.map(x => x.status),
                        datasets: [{ data: statuses.map(x => x.count), backgroundColor: PALETTE, borderWidth: 2, borderColor: '#fff' }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, cutout: '60%', plugins: { legend: { position: 'bottom', labels: { font: { size: 11 }, padding: 10 } } } }
                });
            }

            // Type bar chart
            const types = data.assetsByType || [];
            if (types.length) {
                new Chart(document.getElementById('itTypeChart'), {
                    type: 'bar',
                    data: {
                        labels: types.map(x => x.type),
                        datasets: [{ label: 'Assets', data: types.map(x => x.count), backgroundColor: PALETTE, borderRadius: 8 }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } }, x: { grid: { display: false } } } }
                });
            }

            // Activity visibility check
            if (_canSeeLogsReports) {

                const activities = data.recentItActivities || [];
                const container = document.getElementById('itRecentActivity');
                if (!activities.length) {
                    container.innerHTML = '<p class="text-muted small text-center py-2">No recent activity.</p>';
                } else {
                    container.innerHTML = activities.map(a => `
                        <div class="activity-item-sm">
                            <span class="it-badge-sm">${a.action}</span>
                            <span class="fw-medium">${a.entityName}</span>
                            <span class="text-muted ms-auto">${a.username || ''} · ${a.timestamp}</span>
                        </div>`).join('');
                }
            }
        } catch (e) { console.warn('Dashboard load failed', e); }
    }

    function showItLogsModal() {
        // Redirect to home page logs, filtered to ItAsset
        window.location.href = '/Dashboard?showLogs=ItAsset';
    }

    document.addEventListener('DOMContentLoaded', loadItDashboard);
</script>

<script>
    function openTransferModal(btn) {
        document.getElementById('transferModal').style.display = 'flex';
        document.getElementById('transferAssetId').value = btn.dataset.id;
        document.getElementById('transferAssetName').innerText = btn.dataset.name;
        document.getElementById('transferTargetRoomId').value = btn.dataset.roomid;
    }

    function closeTransferModal() {
        document.getElementById('transferModal').style.display = 'none';
    }

    function openModal(mode) {
        document.getElementById('assetModal').style.display = 'flex';
        const form = document.getElementById('assetForm');
        const activeCampusId = "@(User.FindFirst("ActiveCampusId")?.Value)";
        const selectedRoomId = "@(Model.SelectedRoomId)";

        if (mode === 'addModal') {
            document.getElementById('modalTitle').innerText = 'Add New IT Asset';
            form.action = '?handler=Add';
            document.getElementById('assetId').value = '0';
            document.getElementById('serial').readOnly = false;
            document.getElementById('serial').style.background = 'white';
            form.reset();
            document.getElementById('submitBtn').innerText = 'Add Asset';

            // Restore active campus and filter rooms if context is locked
            if (activeCampusId) {
                const campusInput = document.getElementById('assetCampusId');
                if (campusInput) {
                    campusInput.value = activeCampusId;
                    filterRoomsByCampus(activeCampusId);
                }
            }

            // Auto-select room if we are in a room context
            if (selectedRoomId && selectedRoomId !== "0" && selectedRoomId !== "") {
                const roomSelect = document.getElementById('roomid');
                roomSelect.value = selectedRoomId;
                updateLocationString(roomSelect);
            }

            // Re-enable location fields
            document.getElementById('roomid').disabled = false;
            document.getElementById('roomid').style.background = 'white';
            document.getElementById('roomLockedNote').style.display = 'none';
            const campusSelect = document.getElementById('assetCampusId');
            if (campusSelect && campusSelect.tagName === 'SELECT') {
                campusSelect.disabled = false;
                campusSelect.style.background = 'white';
            }

            // Set current date automatically
            const now = new Date();
            const today = now.toISOString().split('T')[0];
            document.getElementById('dateAdded').value = today;
        }
    }

    function closeModal() {
        document.getElementById('assetModal').style.display = 'none';
        document.getElementById('assetForm').reset();
    }

    function editAsset(btn) {
        const data = btn.dataset;
        
        document.getElementById('assetModal').style.display = 'flex';
        document.getElementById('modalTitle').innerText = 'Edit IT Asset';
        document.getElementById('assetForm').action = '?handler=Update';
        document.getElementById('submitBtn').innerText = 'Update Asset';

        document.getElementById('assetId').value = data.id || "0";
        document.getElementById('name').value = data.name || "";
        document.getElementById('type').value = data.type || "Equipment";
        document.getElementById('brand').value = data.brand || "";
        document.getElementById('model').value = data.model || "";
        document.getElementById('serial').value = data.serial || "";
        document.getElementById('serial').readOnly = true;
        document.getElementById('serial').style.background = '#f1f5f9';
        
        document.getElementById('status').value = data.status || "Working";
        document.getElementById('dateAdded').value = data.dateadded || "";
        document.getElementById('qrcode').value = data.qrcode || "";
        document.getElementById('location').value = data.location || "";
        
        const campusInput = document.getElementById('assetCampusId');
        if (campusInput) {
            campusInput.value = data.campusid || "";
            filterRoomsByCampus(campusInput.value, data.roomid);
        } else {
            document.getElementById('roomid').value = data.roomid || "";
        }

        document.getElementById('submitBtn').innerText = 'Update Asset';

        // Disable location fields for editing
        const roomSelect = document.getElementById('roomid');
        roomSelect.disabled = true;
        roomSelect.style.background = '#f1f5f9';
        document.getElementById('roomLockedNote').style.display = 'block';

        const campusSelect = document.getElementById('assetCampusId');
        if (campusSelect && campusSelect.tagName === 'SELECT') {
            campusSelect.disabled = true;
            campusSelect.style.background = '#f1f5f9';
        }

        // Add form submit listener to re-enable before sending
        const form = document.getElementById('assetForm');
        form.onsubmit = function() {
            roomSelect.disabled = false;
            if (campusSelect) campusSelect.disabled = false;
            return true;
        };
    }

    function filterRoomsByCampus(campusId, selectedRoomId = null) {
        const roomSelect = document.getElementById('roomid');
        const options = roomSelect.options;
        
        for (let i = 0; i < options.length; i++) {
            const opt = options[i];
            if (opt.value === "") continue;
            
            const roomCampusId = opt.getAttribute('data-campusid');
            if (!campusId || roomCampusId === campusId) {
                opt.style.display = "";
            } else {
                opt.style.display = "none";
            }
        }

        if (selectedRoomId) {
            roomSelect.value = selectedRoomId;
        } else {
            const currentOpt = roomSelect.options[roomSelect.selectedIndex];
            if (currentOpt && currentOpt.style.display === "none") {
                roomSelect.value = "";
            }
        }
    }

    function updateLocationString(select) {
        const selectedOption = select.options[select.selectedIndex];
        const roomName = selectedOption.getAttribute('data-name') || "";
        document.getElementById('location').value = roomName;
    }

    // QR Code Functionality
    let currentQrCode = "";
    let currentAssetName = "";

    function showQrModal(btn) {
        const data = btn.dataset;
        currentQrCode = data.id;
        currentAssetName = data.name;

        document.getElementById('qrModal').style.display = 'flex';
        document.getElementById('qrModalTitle').innerText = data.name;
        document.getElementById('qrCodeText').innerText = data.id;
        
        const display = document.getElementById('qrcodeDisplay');
        display.innerHTML = "";
        
        // Generate QR Code (Offline Format)
        const qrContent = `--- QUICKSTOCK ASSET ---
Item: ${data.name}
Brand/Model: ${data.brand} ${data.model}
Serial: ${data.serial}
Location: ${data.location}
Status: ${data.status}
Unique ID: ${data.id}
------------------------`;
        
        new QRCode(display, {
            text: qrContent,
            width: 120,
            height: 120,
            colorDark : "#000000",
            colorLight : "#ffffff",
            correctLevel : QRCode.CorrectLevel.M // Medium level for better readability of text
        });
    }

    function closeQrModal() {
        document.getElementById('qrModal').style.display = 'none';
    }

    function downloadQrPdf() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        const qrSize = 25; // 25mm size
        const centerX = 105;
        const startY = 60;
        
        doc.setFontSize(22);
        doc.setTextColor(99, 102, 241);
        doc.text("QuickStock Asset Tag", centerX, 30, { align: "center" });
        
        doc.setFontSize(16);
        doc.setTextColor(30, 41, 59);
        doc.text(currentAssetName, centerX, 45, { align: "center" });
        
        const qrCanvas = document.querySelector('#qrcodeDisplay canvas');
        if (qrCanvas) {
            const qrImage = qrCanvas.toDataURL("image/png");
            const x = centerX - (qrSize / 2);
            doc.addImage(qrImage, 'PNG', x, startY, qrSize, qrSize);
        }
        
        doc.setFontSize(14);
        doc.setFont(undefined, 'bold');
        doc.text(`ID: ${currentQrCode}`, centerX, startY + qrSize + 10, { align: "center" });
        
        doc.setFontSize(10);
        doc.setFont(undefined, 'normal');
        doc.setTextColor(100, 116, 139);
        doc.text("Scan this QR code to view asset details and location.", centerX, startY + qrSize + 22, { align: "center" });
        
        doc.save(`Asset_QR_${currentQrCode}.pdf`);
    }

    function toggleSelectAll(master) {
        const checkboxes = document.querySelectorAll('.asset-checkbox');
        checkboxes.forEach(cb => cb.checked = master.checked);
    }

    async function generateBatchQr() {
        const selected = Array.from(document.querySelectorAll('.asset-checkbox:checked')).map(cb => JSON.parse(cb.dataset.asset));
        if (selected.length === 0) {
            alert("Please select at least one asset.");
            return;
        }

        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        
        const tempQrDiv = document.createElement('div');
        tempQrDiv.style.visibility = 'hidden';
        tempQrDiv.style.position = 'absolute';
        document.body.appendChild(tempQrDiv);

        const cols = 5;
        const rows = 8;
        const itemsPerPage = cols * rows;
        const qrSize = 25; // 25mm size
        const marginX = 10;
        const marginY = 15;
        const colWidth = 38;
        const rowHeight = 35;

        for (let i = 0; i < selected.length; i++) {
            const asset = selected[i];
            const pageIndex = i % itemsPerPage;
            
            if (i > 0 && pageIndex === 0) doc.addPage();

            const col = pageIndex % cols;
            const row = Math.floor(pageIndex / cols);
            
            const x = marginX + (col * colWidth);
            const y = marginY + (row * rowHeight);

            // Asset Name (Very small)
            doc.setFontSize(8);
            doc.setTextColor(30, 41, 59);
            doc.setFont(undefined, 'bold');
            doc.text(asset.name.substring(0, 25), x + (qrSize/2), y - 3, { align: "center" });

            // Generate QR content
            const qrContent = `--- QUICKSTOCK ASSET ---\nItem: ${asset.name}\nBrand/Model: ${asset.brand} ${asset.model}\nSerial: ${asset.serialNumber}\nLocation: ${asset.location}\nStatus: ${asset.status}\nUnique ID: ${asset.qrcode}\n------------------------`;
            
            tempQrDiv.innerHTML = "";
            new QRCode(tempQrDiv, {
                text: qrContent,
                width: 128,
                height: 128
            });

            await new Promise(r => setTimeout(r, 40));
            
            const qrCanvas = tempQrDiv.querySelector('canvas');
            if (qrCanvas) {
                const qrImage = qrCanvas.toDataURL("image/png");
                doc.addImage(qrImage, 'PNG', x, y, qrSize, qrSize);
            }

            // ID/Serial Text (Tiny)
            doc.setFontSize(6);
            doc.setTextColor(100, 116, 139);
            doc.setFont(undefined, 'normal');
            doc.text(`ID: ${asset.qrcode} | SN: ${asset.serialNumber.substring(0, 15)}`, x + (qrSize/2), y + qrSize + 4, { align: "center" });
        }

        document.body.removeChild(tempQrDiv);
        doc.save(`QuickStock_Batch_QR_${new Date().getTime()}.pdf`);
    }

    async function generateInventoryReport() {
        const btn = document.querySelector('button[onclick="generateInventoryReport()"]');
        const originalContent = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<div class="btn-content"><i class="fas fa-spinner fa-spin"></i><span>Generating...</span></div>';
 
        try {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('l', 'mm', 'a4');
            
            const assetsDataElement = document.getElementById('allAssetsData');
            const assets = JSON.parse(assetsDataElement.textContent);
            const roomName = document.getElementById('currentRoomName').value;
            const campusName = "@User.FindFirst("ActiveCampusName")?.Value" || "Campus Inventory";
            
            // Header
            doc.setFontSize(22);
            doc.setTextColor(16, 185, 129); // Emerald for IT
            doc.setFont(undefined, 'bold');
            doc.text("GOLDEN SUCCESS COLLEGE", 14, 20);
            
            doc.setFontSize(14);
            doc.setTextColor(30, 41, 59);
            const reportTitle = roomName !== "All Rooms" 
                ? `IT Assets Inventory Report - ${roomName} (${campusName})`
                : `IT Assets Inventory Report - All Rooms (${campusName})`;
            doc.text(reportTitle, 14, 30);
            
            doc.setFontSize(10);
            doc.setTextColor(100, 116, 139);
            doc.setFont(undefined, 'normal');
            doc.text(`Total Records: ${assets.length}`, 14, 38);
            doc.text(`Generated: ${new Date().toLocaleString()}`, 14, 44);

            // Summary Statistics
            const stats = {};
            assets.forEach(a => {
                const type = a.type || 'Other';
                const status = (a.status || '').toLowerCase();
                if (!stats[type]) {
                    stats[type] = { working: 0, broken: 0, maintenance: 0 };
                }
                
                if (status === 'working') stats[type].working++;
                else if (status === 'broken') stats[type].broken++;
                else if (status.includes('maintenance')) stats[type].maintenance++;
            });

            doc.setFontSize(11);
            doc.setTextColor(30, 41, 59);
            doc.setFont(undefined, 'bold');
            doc.text("Asset Status Summary:", 14, 54);
            
            doc.setFontSize(10);
            doc.setFont(undefined, 'normal');
            let currentY = 60;
            
            Object.keys(stats).forEach(type => {
                const s = stats[type];
                if (s.working > 0 || s.broken > 0 || s.maintenance > 0) {
                    doc.text(`${type}: ${s.working} Working, ${s.broken} Broken, ${s.maintenance} Maintenance`, 14, currentY);
                    currentY += 6;
                }
            });
 
            const tableData = assets.map(a => [
                a.name || 'N/A',
                `${a.brand} ${a.model}` || 'N/A',
                a.serialNumber || 'N/A',
                a.location || 'N/A',
                a.status || 'N/A',
                a.qrcode || 'N/A'
            ]);
 
            doc.autoTable({
                startY: currentY + 4,
                head: [['Asset Name', 'Brand/Model', 'Serial Number', 'Location', 'Status', 'QR ID']],
                body: tableData,
                theme: 'striped',
                headStyles: { fillColor: [16, 185, 129], textColor: 255, fontStyle: 'bold' },
                alternateRowStyles: { fillColor: [248, 250, 252] },
                margin: { top: 50 },
                styles: { font: 'helvetica', fontSize: 9 }
            });
 
            doc.save(`IT_Inventory_Report_${new Date().toISOString().split('T')[0]}.pdf`);
        } catch (e) {
            console.error(e);
            alert('Failed to generate report.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalContent;
        }
    }


    // Close on click outside
    window.onclick = function(event) {
        let assetModal = document.getElementById('assetModal');
        let qrModal = document.getElementById('qrModal');
        let transferModal = document.getElementById('transferModal');
        
        if (event.target == assetModal) closeModal();
        if (event.target == qrModal) closeQrModal();
        if (event.target == transferModal) closeTransferModal();
    }

    // Auto-trigger report if parameter is present
    window.addEventListener('DOMContentLoaded', function() {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('triggerReport') === 'true') {
            setTimeout(generateInventoryReport, 500); // Small delay to ensure everything is ready
            
            // Clean up URL without refreshing
            const newUrl = window.location.pathname + window.location.search.replace(/[?&]triggerReport=true/, '').replace(/^&/, '?').replace(/\?$/, '');
            window.history.replaceState({}, document.title, newUrl);
        }
    });
    // Instant Search Logic
    let searchTimeout = null;
    const searchInput = document.getElementById('itAssetSearchInput');
    const roomSelect = document.getElementById('roomFilterSelect');
    const tableWrapper = document.getElementById('assetTableWrapper');
    const spinner = document.getElementById('searchSpinner');

    function performSearch(page = 1) {
        const searchTerm = searchInput.value;
        const roomId = roomSelect.value;
        
        if (spinner) {
            spinner.style.display = 'inline-block';
            spinner.title = "Searching...";
        }
        
        const url = `?SearchTerm=${encodeURIComponent(searchTerm)}&SelectedRoomId=${roomId}&CurrentPage=${page}&tab=list`;
        
        fetch(url)
            .then(response => response.text())
            .then(html => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const newTable = doc.getElementById('assetTableWrapper');
                
                if (newTable) {
                    tableWrapper.innerHTML = newTable.innerHTML;
                    // Re-bind pagination links to use AJAX
                    bindPaginationLinks();
                }
                
                // Toggle clear button visibility
                let clearBtn = document.getElementById('clearSearchBtn');
                if (searchTerm) {
                    if (!clearBtn) {
                        const searchBox = document.querySelector('.search-box');
                        const a = document.createElement('a');
                        a.id = 'clearSearchBtn';
                        a.href = `?SelectedRoomId=${roomId}`;
                        a.style.color = 'var(--text-muted)';
                        a.style.textDecoration = 'none';
                        a.style.padding = '0.25rem';
                        a.style.display = 'flex';
                        a.style.alignItems = 'center';
                        a.innerHTML = '<i class="fas fa-times-circle"></i>';
                        searchBox.appendChild(a);
                    } else {
                        clearBtn.href = `?SelectedRoomId=${roomId}`;
                    }
                } else if (clearBtn) {
                    clearBtn.remove();
                }

                // Update URL without reload
                window.history.replaceState({}, '', url);
                
                if (spinner) spinner.style.display = 'none';
            })
            .catch(err => {
                console.error('Search failed:', err);
                if (spinner) spinner.style.display = 'none';
            });
    }

    function bindPaginationLinks() {
        const links = tableWrapper.querySelectorAll('.pagination a.page-link');
        links.forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                const url = new URL(link.href, window.location.origin);
                const page = url.searchParams.get('CurrentPage') || 1;
                performSearch(page);
            });
        });
    }

    searchInput.addEventListener('input', () => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => performSearch(1), 400); // 400ms debounce
    });

    roomSelect.addEventListener('change', () => performSearch(1));
    
    // Initial binding for existing pagination
    document.addEventListener('DOMContentLoaded', bindPaginationLinks);

    function openFurnitureModal() {
        document.getElementById('furnitureModal').style.display = 'flex';
    }

    function closeFurnitureModal() {
        document.getElementById('furnitureModal').style.display = 'none';
        document.getElementById('furnitureForm').reset();
    }

    function updateFurnitureLocationString(select) {
        const roomName = select.options[select.selectedIndex].getAttribute('data-name');
        document.getElementById('furnitureLocation').value = roomName;
    }
</script>

