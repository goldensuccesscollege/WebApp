@page
@model QuickStockApp.Pages.Inventory.ItAssetsModel
@{
    ViewData["Title"] = "IT Assets";
    var campusId = User.FindFirst("ActiveCampusId")?.Value;
    var isAdmin = User.IsInRole("Admin") || User.IsInRole("Library Admin") || User.IsInRole("Home Economics Admin");
    var isManager = User.IsInRole("Manager");
    var isUser = User.IsInRole("User");
    var isViewer = User.IsInRole("Viewer");
    
    // Permission helpers
    var canAdd = isAdmin || isManager || isUser;
    var canUpdate = isAdmin || isManager;
    var canDelete = isAdmin;
    var canTransfer = isAdmin || isManager || isUser;
    var canSeeLogsReports = isAdmin || isManager || isUser;

    bool showListTab = Model.SelectedRoomId.HasValue || !string.IsNullOrEmpty(Model.SearchTerm) || Request.Query["tab"] == "list";
}

<!-- Tab Navigation -->
<div class="d-flex justify-content-center mb-4 animate-in">
    <ul class="nav nav-pills bg-white p-1 rounded-pill shadow-sm" id="itAssetsTabs" role="tablist" style="border: 1px solid rgba(99,102,241,0.15);">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(!showListTab ? "active" : "") rounded-pill px-4 py-2 fw-bold" id="dashboard-tab" data-bs-toggle="pill" data-bs-target="#dashboard-view" type="button" role="tab" aria-controls="dashboard-view" aria-selected="@(!showListTab ? "true" : "false")" style="transition: all 0.3s;">
                <i class="fas fa-chart-pie me-2"></i> Overview Dashboard
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(showListTab ? "active" : "") rounded-pill px-4 py-2 fw-bold text-secondary" id="list-tab" data-bs-toggle="pill" data-bs-target="#list-view" type="button" role="tab" aria-controls="list-view" aria-selected="@(showListTab ? "true" : "false")" style="transition: all 0.3s;">
                <i class="fas fa-list me-2"></i> Asset Inventory List
            </button>
        </li>
    </ul>
</div>

<div class="tab-content" id="itAssetsTabContent">
    <!-- DASHBOARD TAB -->
    <div class="tab-pane fade @(!showListTab ? "show active" : "")" id="dashboard-view" role="tabpanel" aria-labelledby="dashboard-tab">
        <!-- IT Assets Mini Dashboard -->
        <div id="it-dashboard-section" class="mb-4">
            <!-- Stats row -->
    <div class="row g-3 mb-3" id="itDashStats">
        <div class="col-12 d-flex align-items-center gap-2 mb-1">
            <h5 class="fw-bold mb-0" style="background: var(--primary-gradient,linear-gradient(135deg,#6366f1,#a855f7)); -webkit-background-clip:text; -webkit-text-fill-color:transparent;">
                <i class="fas fa-chart-bar me-2" style="-webkit-text-fill-color:#6366f1;"></i>IT Assets Dashboard
            </h5>
            <button class="btn btn-sm btn-link text-muted p-0 ms-auto" onclick="toggleDashboard()" id="dashToggleBtn" title="Toggle dashboard">
                <i class="fas fa-chevron-up" id="dashToggleIcon"></i>
            </button>
        </div>
    </div>
    <div id="itDashContent">
        <div class="row g-3 mb-3" id="itStatCards">
            <div class="col-md-3 col-6">
                <div class="it-stat-card" style="--c:var(--primary-color);">
                    <div class="it-stat-icon" style="background:rgba(31,60,136,0.1);color:var(--primary-color);"><i class="fas fa-laptop-code"></i></div>
                    <div><div class="it-stat-val" id="stat-total">—</div><div class="it-stat-lbl">Total Assets</div></div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="it-stat-card" style="--c:var(--success-color);">
                    <div class="it-stat-icon" style="background:rgba(46,125,50,0.1);color:var(--success-color);"><i class="fas fa-check-circle"></i></div>
                    <div><div class="it-stat-val" id="stat-working">—</div><div class="it-stat-lbl">Working</div></div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="it-stat-card" style="--c:var(--accent-color);">
                    <div class="it-stat-icon" style="background:rgba(214,40,40,0.1);color:var(--accent-color);"><i class="fas fa-times-circle"></i></div>
                    <div><div class="it-stat-val" id="stat-broken">—</div><div class="it-stat-lbl">Broken</div></div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="it-stat-card" style="--c:var(--secondary-color);">
                    <div class="it-stat-icon" style="background:rgba(244,196,48,0.1);color:var(--secondary-color);"><i class="fas fa-tools"></i></div>
                    <div><div class="it-stat-val" id="stat-maintenance">—</div><div class="it-stat-lbl">Maintenance</div></div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-lg-5">
                <div class="glass-card p-3 h-100">
                    <h6 class="fw-bold mb-2 small text-muted text-uppercase">Status Breakdown</h6>
                    <div style="position: relative; height: 180px; width: 100%;">
                        <canvas id="itStatusChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="glass-card p-3 h-100">
                    <h6 class="fw-bold mb-2 small text-muted text-uppercase">Assets by Type</h6>
                    <div style="position: relative; height: 180px; width: 100%;">
                        <canvas id="itTypeChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        @if (canSeeLogsReports)
        {

            <div class="glass-card p-3 mb-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="fw-bold mb-0 small text-muted text-uppercase"><i class="fas fa-history me-1"></i>Recent IT Asset Activity</h6>
                    <button class="btn btn-sm btn-link text-decoration-none small p-0" onclick="showItLogsModal()">View all</button>
                </div>
                <div id="itRecentActivity" class="activity-list-sm">
                    <div class="text-center text-muted small py-2"><div class="spinner-border spinner-border-sm"></div></div>
                </div>
            </div>
        }
    </div>
</div>
    </div> <!-- END DASHBOARD TAB -->

    <!-- LIST TAB -->
    <div class="tab-pane fade @(showListTab ? "show active" : "")" id="list-view" role="tabpanel" aria-labelledby="list-tab">

<div class="assets-container">
    <div class="header-section">
        <div class="header-content">
            <h1 class="premium-title">IT Assets Explorer</h1>
            <p class="subtitle">Manage and track your organization's technology hardware and materials.</p>
        </div>
        
        <div class="header-actions">
            <div class="header-filters" style="display: flex; gap: 1rem; align-items: center;">
                <div class="search-box glass-panel" style="display: flex; gap: 0.5rem; align-items: center; padding: 0.25rem 1rem; border-radius: 16px; height: 48px;">
                    <i class="fas fa-search" style="color: var(--text-muted);"></i>
                    <input type="text" asp-for="SearchTerm" id="itAssetSearchInput" placeholder="Search anything (name, brand, serial, status...)" style="border: none; background: transparent; padding: 0.5rem; outline: none; width: 300px; font-weight: 600; color: var(--text-dark);" autocomplete="off" />
                    <div id="searchSpinner" class="spinner-border spinner-border-sm text-primary" style="display: none;"></div>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <a href="?SelectedRoomId=@Model.SelectedRoomId" id="clearSearchBtn" style="color: var(--text-muted); text-decoration: none; padding: 0.25rem; display: flex; align-items: center;"><i class="fas fa-times-circle"></i></a>
                    }
                </div>

                <select asp-for="SelectedRoomId" id="roomFilterSelect" class="room-filter" style="height: 48px;">
                    <option value="">All Rooms</option>
                    @foreach (var room in Model.Rooms)
                    {
                        <option value="@room.RoomId">@room.RoomName</option>
                    }
                </select>
            </div>
            @if (canAdd)
            {

                <button class="add-asset-btn animate-in" onclick="openModal('addModal')" style="height: 48px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    Add New Asset
                </button>


            }
            @if (canSeeLogsReports)
            {
                <button class="batch-qr-btn animate-in" onclick="generateBatchQr()" style="background: var(--text-dark); color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 16px; font-weight: 700; display: flex; align-items: center; gap: 0.5rem; cursor: pointer; transition: all 0.3s; height: 48px;">
                    <i class="fas fa-layer-group me-1"></i> Batch QR PDF
                </button>
                <button class="report-btn animate-in" onclick="generateInventoryReport()" style="background: #10b981; color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 16px; font-weight: 700; display: flex; align-items: center; gap: 0.5rem; cursor: pointer; transition: all 0.3s; height: 48px;">
                    <i class="fas fa-file-pdf me-1"></i> Generate Report
                </button>
            }

        </div>
    </div>


    <div id="assetTableWrapper" class="table-container glass-panel animate-in">
        <script id="allAssetsData" type="application/json">@Html.Raw(Json.Serialize(Model.AllAssets))</script>
        <input type="hidden" id="currentRoomName" value='@(Model.Rooms.FirstOrDefault(r => r.RoomId == Model.SelectedRoomId)?.RoomName ?? "All Rooms")' />
        
        <table class="premium-table">
            <thead>
                <tr>
                    <th style="width: 40px;">@if(canTransfer){<input type="checkbox" id="selectAll" onclick="toggleSelectAll(this)" />}</th>
                    <th>Asset Details</th>
                    <th>Specifications</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var asset in Model.Assets)
                {
                    <tr class="asset-row">
                        <td>@if(canTransfer){<input type="checkbox" class="asset-checkbox" data-asset='@Json.Serialize(asset)' />}</td>
                        <td>
                            <div class="asset-name-cell">
                                <div class="asset-icon @asset.Type.ToLower()">
                                    @if(asset.Type == "Equipment") {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                                    } else if(asset.Type == "Component") {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="15" x2="23" y2="15"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="15" x2="4" y2="15"></line></svg>
                                    } else {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                                    }
                                </div>
                                <div class="d-flex flex-column">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="asset-name-text">@asset.Name</span>
                                        <span class="type-badge @asset.Type.ToLower()" style="font-size: 0.6rem; padding: 0.15rem 0.5rem;">@asset.Type</span>
                                    </div>
                                    <span class="text-muted" style="font-size: 0.7rem;">Added @asset.DateAdded.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="brand-model">
                                <span class="brand">@asset.Brand @asset.Model</span>
                                <code class="serial-text mt-1" style="font-size: 0.75rem; width: fit-content;">SN: @asset.SerialNumber</code>
                            </div>
                        </td>
                        <td><span class="location-badge">@(asset.Room?.RoomName ?? asset.Location)</span></td>
                        <td><span class="status-pill @asset.Status.ToLower().Replace(" ", "-")">@asset.Status</span></td>
                        <td class="text-right">
                            <div class="action-btns">
                                <button class="icon-btn qr-btn" 
                                        onclick="showQrModal(this)" 
                                        data-id="@asset.Qrcode"
                                        data-name="@asset.Name"
                                        data-brand="@asset.Brand"
                                        data-model="@asset.Model"
                                        data-serial="@asset.SerialNumber"
                                        data-location="@(asset.Room?.RoomName ?? asset.Location)"
                                        data-status="@asset.Status"
                                        title="Show QR Code">
                                    <i class="fas fa-qrcode"></i>
                                </button>
                                @if (canUpdate)
                                {
                                    <button class="icon-btn edit-btn" 
                                            data-id="@asset.Id"
                                            data-name="@asset.Name"
                                            data-type="@asset.Type"
                                            data-brand="@asset.Brand"
                                            data-model="@asset.Model"
                                            data-serial="@asset.SerialNumber"
                                            data-location="@(asset.Room?.RoomName ?? asset.Location)"
                                            data-status="@asset.Status"
                                            data-dateadded="@asset.DateAdded.ToString("yyyy-MM-dd")"
                                            data-qrcode="@asset.Qrcode"
                                            data-campusid="@asset.CampusId"
                                            data-roomid="@asset.RoomId"
                                            onclick="editAsset(this)"
                                            title="Edit Asset Details">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    </button>
                                }

                                @if (canTransfer)
                                {
                                    <button class="icon-btn transfer-btn" 
                                            data-id="@asset.Id"
                                            data-name="@asset.Name"
                                            data-roomid="@asset.RoomId"
                                            title="Transfer Room"
                                            onclick="openTransferModal(this)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 3 21 3 21 8"></polyline><line x1="10" y1="14" x2="21" y2="3"></line><polyline points="7 21 2 21 2 16"></polyline><line x1="14" y1="10" x2="2" y2="21"></line></svg>
                                    </button>
                                }

                                @if (canDelete)
                                {
                                    <form asp-page-handler="Delete" asp-route-id="@asset.Id" method="post" style="display:inline;">
                                        <button class="icon-btn delete-btn" onclick="return confirm('Are you sure you want to delete this asset?')" title="Delete Asset">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                        </button>
                                    </form>
                                }

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        
        @if (Model.TotalPages > 1)
        {
            <div class="pagination-container d-flex justify-content-between align-items-center mt-4 px-3 pb-3">
                <div class="text-muted small">
                    Showing @(((Model.CurrentPage - 1) * ItAssetsModel.PageSize) + 1) to @(Math.Min(Model.CurrentPage * ItAssetsModel.PageSize, (Model.TotalPages * ItAssetsModel.PageSize))) of data
                </div>
                <nav aria-label="Asset pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-page="./ItAssets" 
                               asp-route-CurrentPage="@(Model.CurrentPage - 1)" 
                               asp-route-SelectedRoomId="@Model.SelectedRoomId"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-tab="list">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                        
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link" asp-page="./ItAssets" 
                                   asp-route-CurrentPage="@i"
                                   asp-route-SelectedRoomId="@Model.SelectedRoomId"
                                   asp-route-SearchTerm="@Model.SearchTerm"
                                   asp-route-tab="list">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-page="./ItAssets" 
                               asp-route-CurrentPage="@(Model.CurrentPage + 1)"
                               asp-route-SelectedRoomId="@Model.SelectedRoomId"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-tab="list">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
    </div> <!-- END LIST TAB -->
</div> <!-- END TAB CONTENT -->

<style>
    /* Tab pill active styles */
    .nav-pills .nav-link.active {
        background: var(--primary-gradient, linear-gradient(135deg, #6366f1 0%, #a855f7 100%));
        color: white !important;
        box-shadow: 0 4px 10px rgba(99, 102, 241, 0.3);
    }
    .nav-pills .nav-link:not(.active):hover {
        background: rgba(99, 102, 241, 0.05);
        color: #6366f1 !important;
    }

    /* Pagination Styling */
    .pagination-container {
        border-top: 1px solid rgba(0,0,0,0.05);
        padding-top: 1.5rem !important;
    }
    .page-link {
        border-radius: 8px !important;
        margin: 0 3px;
        border: 1px solid #e2e8f0;
        color: #64748b;
        font-weight: 600;
        transition: all 0.2s;
    }
    .page-link:hover {
        background: #f1f5f9;
        color: var(--primary-blue);
        border-color: var(--primary-blue);
    }
    .page-item.active .page-link {
        background: var(--primary-gradient) !important;
        border-color: transparent !important;
        box-shadow: 0 4px 10px rgba(99, 102, 241, 0.3);
    }
    body.dark-mode .page-link {
        background: rgba(30, 41, 59, 0.6);
        border-color: rgba(255,255,255,0.1);
        color: #94a3b8;
    }
    body.dark-mode .page-link:hover {
        background: rgba(255,255,255,0.05);
    }
    body.dark-mode .pagination-container {
        border-top-color: rgba(255,255,255,0.05);
    }
</style>

<!-- Add/Edit Modal Container -->
<div id="assetModal" class="modal-overlay">
    <div class="modal-content glass-card animate-in">
        <div class="modal-header">
            <h2 id="modalTitle">Manage Asset</h2>
            <button class="close-btn" onclick="closeModal()">×</button>
        </div>
        <form method="post" id="assetForm">
            <input type="hidden" asp-for="Asset.Id" id="assetId" />
            
            @{
                var activeCampusId = User.FindFirst("ActiveCampusId")?.Value;
                bool hideCampusSelect = !string.IsNullOrEmpty(activeCampusId);
            }

            @if (Model.AssignedCampuses.Count > 1 && !hideCampusSelect)
            {
                <div class="form-group px-3">
                    <label asp-for="Asset.CampusId">Campus</label>
                    <select asp-for="Asset.CampusId" id="assetCampusId" required onchange="filterRoomsByCampus(this.value)">
                        <option value="">Select Campus</option>
                        @foreach (var campus in Model.AssignedCampuses)
                        {
                            <option value="@campus.CampusId">@campus.Name</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="Asset.CampusId" id="assetCampusId" value="@activeCampusId" />
            }

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="Asset.Name">Asset Name</label>
                    <input asp-for="Asset.Name" id="name" required />
                </div>
                <div class="form-group">
                    <label asp-for="Asset.Type">Type</label>
                    <select asp-for="Asset.Type" id="type" required>
                        <option value="Equipment">Equipment</option>
                        <option value="Materials">Materials</option>
                        <option value="Component">Component</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="Asset.Brand">Brand</label>
                    <input asp-for="Asset.Brand" id="brand" required />
                </div>
                <div class="form-group">
                    <label asp-for="Asset.Model">Model</label>
                    <input asp-for="Asset.Model" id="model" required />
                </div>
                <div class="form-group">
                    <label asp-for="Asset.SerialNumber">Serial Number</label>
                    <input asp-for="Asset.SerialNumber" id="serial" required />
                </div>
                <div class="form-group">
                    <label asp-for="Asset.RoomId">Location (Room)</label>
                    <select asp-for="Asset.RoomId" id="roomid" required onchange="updateLocationString(this)">
                        <option value="">Select Room</option>
                        @foreach (var room in Model.Rooms)
                        {
                            <option value="@room.RoomId" data-name="@room.RoomName" data-campusid="@room.CampusId">@room.RoomName</option>
                        }
                    </select>
                    <div id="roomLockedNote" class="mt-1 small text-muted" style="display:none;">
                        <i class="fas fa-lock me-1"></i> Location is locked. Use the <strong class="text-primary">Transfer</strong> action to change rooms.
                    </div>
                    <input type="hidden" asp-for="Asset.Location" id="location" />
                    @if (Model.SelectedRoomId.HasValue)
                    {
                        <div class="mt-1 small text-info"><i class="fas fa-info-circle me-1"></i> Pre-selected from current view</div>
                    }
                </div>
                <div class="form-group">
                    <label asp-for="Asset.Status">Status</label>
                    <select asp-for="Asset.Status" id="status" required>
                        <option value="Working">Working</option>
                        <option value="Broken">Broken</option>
                        <option value="UnderMaintenance">Under Maintenance</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="Asset.DateAdded">Date Added</label>
                    <input type="date" asp-for="Asset.DateAdded" id="dateAdded" required />
                </div>
                <div class="form-group" style="opacity: 0.6; pointer-events: none;">
