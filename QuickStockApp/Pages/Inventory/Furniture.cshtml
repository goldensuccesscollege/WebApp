    function closeFurnitureModal() {
        document.getElementById('furnitureModal').style.display = 'none';
    }

    function openTransferModal(id, name, location) {
        document.getElementById('transferFurnitureId').value = id;
        document.getElementById('transferFurnitureName').innerText = name;
        document.getElementById('transferCurrentLocation').innerText = location || "Unassigned";
        document.getElementById('transferModal').style.display = 'flex';
    }

    function closeTransferModal() {
        document.getElementById('transferModal').style.display = 'none';
    }

    function updateLocation(select) {
        const option = select.options[select.selectedIndex];
        document.getElementById('furnitureRoomId').value = select.value;
        document.getElementById('furnitureLocation').value = option.getAttribute('data-name') || '';
    }

    function showQr(code, name, id) {
        if (!code || code === 'null' || code === 'undefined') {
            code = "FURN-" + id.replace('#', '');
        }

        const numericId = parseInt(id.replace('#', ''));
        let details = "ID: " + code;
        
        // Find the item data from the checkboxes (most reliable way)
        const checkboxes = document.querySelectorAll('.asset-checkbox');
        for (let cb of checkboxes) {
            try {
                const item = JSON.parse(cb.dataset.asset);
                if (item.Item_ID === numericId) {
                    details = `--- QUICKSTOCK ASSET ---\nFurniture: ${item.Item_Name || 'N/A'}\nItem #: ${item.Item_number || 'N/A'}\nLocation: ${item.Location || 'N/A'}\nCondition: ${item.Condition || 'N/A'}\nUnique ID: ${item.Item_ID}\n------------------------`;
                    break;
                }
            } catch (e) { console.error("Error parsing asset data", e); }
        }

        document.getElementById('qrTitle').innerText = name;
        document.getElementById('qrText').innerText = code;
        
        const display = document.getElementById('qrImage').parentElement;
        // Replace img with div for qrcode.js
        display.innerHTML = '<div id="qrInternalContainer" class="d-inline-block p-3 bg-white rounded-4 shadow-sm"></div>';
        
        new QRCode(document.getElementById('qrInternalContainer'), {
            text: details,
            width: 250,
            height: 250,
            colorDark : "#0F172A",
            colorLight : "#ffffff",
            correctLevel : QRCode.CorrectLevel.M
        });
        
        document.getElementById('qrModal').style.display = 'flex';
    }

    function closeQrModal() {
        document.getElementById('qrModal').style.display = 'none';
    }

    window.onclick = function(event) {
        if (event.target.classList.contains('modal-overlay')) {
            event.target.style.display = 'none';
        }
    }

    // ===== LIVE SEARCH =====
    (function () {
        const input   = document.getElementById('furnitureSearchInput');
        const clearBtn = document.getElementById('furnitureSearchClear');
        const countBadge = document.getElementById('furnitureResultCount');
        const tbody   = document.getElementById('furnitureTableBody');

        if (!input || !tbody) return;

        function updateCount(visible, total) {
            if (input.value.trim() === '') {
                countBadge.textContent = '';
            } else {
                countBadge.textContent = `${visible} of ${total} result${visible !== 1 ? 's' : ''}`;
            }
        }

        function filterTable() {
            const q = input.value.trim().toLowerCase();
            clearBtn.style.display = q ? 'inline-block' : 'none';

            const allRows = Array.from(tbody.querySelectorAll('tr[data-search]'));
            let visibleCount = 0;

            allRows.forEach(row => {
                const haystack = row.getAttribute('data-search') || '';
                const match = haystack.includes(q);
                row.style.display = match ? '' : 'none';
                if (match) visibleCount++;
            });

            // Show/hide empty state
            let emptyRow = tbody.querySelector('tr.no-results-row');
            if (visibleCount === 0 && q) {
                if (!emptyRow) {
                    emptyRow = document.createElement('tr');
                    emptyRow.className = 'no-results-row';
                    emptyRow.innerHTML = `<td colspan="8" class="text-center py-5 text-muted">
                        <div class="py-3">
                            <i class="fas fa-search fa-2x mb-3 opacity-25"></i>
                            <p class="fw-600 mb-0">No furniture matched "<strong>${input.value}</strong>"</p>
                            <small class="text-muted">Try a different name, brand, item #, or location</small>
                        </div>
                    </td>`;
                    tbody.appendChild(emptyRow);
                }
                emptyRow.style.display = '';
            } else if (emptyRow) {
                emptyRow.style.display = 'none';
            }

            updateCount(visibleCount, allRows.length);
        }

        input.addEventListener('input', filterTable);

        // If user typed something before JS loaded (e.g. browser autofill), run immediately
        if (input.value) filterTable();

        // Auto-focus when switching to the List tab
        document.getElementById('list-tab')?.addEventListener('click', () => {
            setTimeout(() => input.focus(), 200);
        });
    })();

    function clearFurnitureSearch() {
        const input = document.getElementById('furnitureSearchInput');
        if (input) { input.value = ''; input.dispatchEvent(new Event('input')); input.focus(); }
    }

    function toggleSelectAll(master) {
        const checkboxes = document.querySelectorAll('.asset-checkbox');
        checkboxes.forEach(cb => cb.checked = master.checked);
    }

    async function generateBatchQr() {
        const selected = Array.from(document.querySelectorAll('.asset-checkbox:checked')).map(cb => JSON.parse(cb.dataset.asset));
        if (selected.length === 0) {
            alert("Please select at least one item.");
            return;
        }

        const btn = document.querySelector('button[onclick="generateBatchQr()"]');
        const originalContent = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Generating PDF...';

        try {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();
            
            const tempQrDiv = document.createElement('div');
            tempQrDiv.style.visibility = 'hidden';
            tempQrDiv.style.position = 'absolute';
            document.body.appendChild(tempQrDiv);

            const cols = 5;
            const rows = 8;
            const itemsPerPage = cols * rows;
            const qrSize = 25; 
            const marginX = 10;
            const marginY = 15;
            const colWidth = 38;
            const rowHeight = 35;

            for (let i = 0; i < selected.length; i++) {
            const item = selected[i];
            const pageIndex = i % itemsPerPage;
            
            if (i > 0 && pageIndex === 0) doc.addPage();

            const col = pageIndex % cols;
            const row = Math.floor(pageIndex / cols);
            
            const x = marginX + (col * colWidth);
            const y = marginY + (row * rowHeight);

            // Item Name
            doc.setFontSize(7);
            doc.setTextColor(30, 41, 59);
            doc.setFont(undefined, 'bold');
            doc.text((item.Item_Name || "Unnamed").substring(0, 22), x + (qrSize/2), y - 3, { align: "center" });

            // Direct Text QR Content (Exactly like IT Assets)
            const qrContent = `--- QUICKSTOCK ASSET ---\nFurniture: ${item.Item_Name || 'N/A'}\nItem #: ${item.Item_number || 'N/A'}\nLocation: ${item.Location || 'N/A'}\nCondition: ${item.Condition || 'N/A'}\nUnique ID: ${item.Item_ID}\n------------------------`;
            
            const codeValue = item.Qrcode || ("FURN-" + item.Item_ID);
            
            tempQrDiv.innerHTML = "";
            new QRCode(tempQrDiv, {
                text: qrContent,
                width: 128,
                height: 128
            });

            await new Promise(r => setTimeout(r, 50));
            
            const qrCanvas = tempQrDiv.querySelector('canvas');
            if (qrCanvas) {
                const qrImage = qrCanvas.toDataURL("image/png");
                doc.addImage(qrImage, 'PNG', x, y, qrSize, qrSize);
            }

            // Footer Text
            doc.setFontSize(5);
            doc.setTextColor(100, 116, 139);
            doc.setFont(undefined, 'normal');
            doc.text(`ID: ${codeValue} | ${item.Brand || ""}`, x + (qrSize/2), y + qrSize + 4, { align: "center" });
        }

        document.body.removeChild(tempQrDiv);

            doc.save(`Furniture_Batch_QR_${new Date().getTime()}.pdf`);
        } catch (err) {
            console.error(err);
            alert("Error generating PDF: " + err.message);
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalContent;
        }
    }
</script>
