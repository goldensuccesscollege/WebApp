    function openEditModal(item) {
        document.getElementById('modalTitle').innerText = "Edit Furniture Details";
        document.getElementById('furnitureForm').setAttribute('asp-page-handler', 'UpdateFurniture');
        document.getElementById('furnitureForm').action = "?handler=UpdateFurniture";
        
