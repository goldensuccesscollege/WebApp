        document.getElementById('furnitureForm').setAttribute('asp-page-handler', 'AddFurniture');
        document.getElementById('furnitureForm').action = "?handler=AddFurniture";
        document.getElementById('editItemId').value = 0;
        document.getElementById('editItemName').value = "";
        document.getElementById('editItemNumber').value = "";
        document.getElementById('editBrand').value = "";
        document.getElementById('editCondition').value = "";
        document.getElementById('editItemCount').value = 1;
        document.getElementById('locationGroup').style.display = 'block';
        document.getElementById('furnitureModal').style.display = 'flex';
