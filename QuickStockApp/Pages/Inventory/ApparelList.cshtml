    .section-title { font-size: 0.85rem; font-weight: 800; color: var(--primary); text-transform: uppercase; letter-spacing: 0.1em; border-bottom: 2px solid rgba(99,102,241,0.1); padding-bottom: 0.5rem; margin-bottom: 1.25rem; }
    .form-row { display: flex; gap: 1.5rem; margin-bottom: 1.5rem; }
    .input-group-premium { display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
    .input-group-premium.full-width { flex: 0 0 100%; }
    .input-group-premium label { font-size: 0.8rem; font-weight: 800; color: var(--text-muted); }
    .input-group-premium input, .input-group-premium select, .input-group-premium textarea { padding: 0.85rem 1.15rem; border-radius: 14px; border: 1.5px solid #e2e8f0; background: #f8fafc; font-weight: 600; font-family: var(--font-main); transition: all 0.2s; }
    .input-group-premium input:focus, .input-group-premium select:focus, .input-group-premium textarea:focus { border-color: var(--primary); outline: none; background: white; box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1); }
    
    .price-input-wrapper { position: relative; }
    .currency-symbol { position: absolute; left: 1.15rem; top: 50%; transform: translateY(-50%); font-weight: 800; color: var(--text-muted); }
    .price-input-wrapper input { padding-left: 2.25rem; }

    .btn-flat { background: transparent; border: none; font-weight: 700; color: var(--text-muted); padding: 0.75rem 1.5rem; cursor: pointer; }
    .btn-mini { padding: 0.4rem 0.8rem; border-radius: 8px; border: 1px solid #e2e8f0; background: white; font-size: 0.75rem; font-weight: 700; cursor: pointer; transition: all 0.2s; margin: 0 2px; }
    .btn-mini:hover { background: #f1f5f9; border-color: #cbd5e1; }
    .pagination-controls { display: flex; align-items: center; gap: 4px; }

    /* Animations */
    .animate-fade-in { animation: fadeIn 0.6s ease-out; }
    .animate-slide-up { animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
    .animate-zoom-in { animation: zoomIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .animate-pulse { animation: pulse 2s infinite; }

    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes slideUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes zoomIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
    @@keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.4); } 70% { box-shadow: 0 0 0 15px rgba(99, 102, 241, 0); } 100% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0); } }
</style>

<script>
    let currentModalItems = [];
    let currentApparelId = 0;
    let itemCurrentPage = 1;
    const itemPageSize = 5;
    let itemsChanged = false;

    function openAddModal() {
        document.getElementById('apparelModal').style.display = 'flex';
        document.getElementById('modalTitle').innerText = 'Register Apparel';
        document.getElementById('apparelForm').action = '?handler=Add';
        document.getElementById('apparelId').value = '0';
        document.getElementById('apparelForm').reset();
        document.querySelector('#submitBtn span').innerText = 'Confirm Entry';
        
        const activeCampusId = "@(User.FindFirst("ActiveCampusId")?.Value)";
        document.getElementById('apparelCampusId').value = activeCampusId;
    }

    function closeModal() {
        document.getElementById('apparelModal').style.display = 'none';
    }

    function editApparel(btn) {
        const d = btn.dataset;
        document.getElementById('apparelModal').style.display = 'flex';
        document.getElementById('modalTitle').innerText = 'Update Product';
        document.getElementById('apparelForm').action = '?handler=Update';
        document.querySelector('#submitBtn span').innerText = 'Save Changes';

        document.getElementById('apparelId').value = d.id;
        document.getElementById('apparelName').value = d.name;
        document.getElementById('category').value = d.category;
        document.getElementById('sex').value = d.sex;
        document.getElementById('size').value = d.size;
        document.getElementById('gradeLevel').value = d.grade;
        document.getElementById('stock').value = d.stock;
        document.getElementById('reorder').value = d.reorder;
        document.getElementById('price').value = d.price;
        document.getElementById('date').value = d.date;
        document.getElementById('supplier').value = d.supplier;
        document.getElementById('remarks').value = d.remarks;
        document.getElementById('location').value = d.location || "";
        document.getElementById('apparelCampusId').value = d.campusid;
    }

    async function viewItems(id) {
        const apparelList = @Html.Raw(Json.Serialize(Model.Apparel));
        console.log("Looking for ID:", id, "in list:", apparelList);
        const item = apparelList.find(i => (i.apparel_ID || i.Apparel_ID) === id);
        
        if (!item) {
            console.error("Item not found in local list. ID:", id);
            return;
        }

        document.getElementById('itemsModal').style.display = 'flex';
        document.getElementById('itemsModalTitle').innerText = item.apparel_Name || item.Apparel_Name;
        document.getElementById('itemsModalSubtitle').innerText = `${item.category || item.Category} • ${item.sex || item.Sex} Size ${item.size || item.Size}`;
        
        const tbody = document.getElementById('itemsTableBody');
        currentApparelId = id;
        tbody.innerHTML = '<tr><td colspan="5" class="text-center" style="padding: 3rem;"><i class="fas fa-circle-notch fa-spin fa-2x" style="color: var(--primary);"></i><p style="margin-top: 1rem; font-weight: 700;">Scanning Inventory Records...</p></td></tr>';
        
        try {
            const response = await fetch(`?handler=ApparelItems&apparelId=${id}`);
            if (!response.ok) throw new Error('API error');
            currentModalItems = await response.json();
            console.log("Retrieved items:", currentModalItems);
            itemsChanged = false;
            renderItems(1);
        } catch (error) {
            console.error(error);
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger"><i class="fas fa-exclamation-triangle"></i> Failed to retrieve inventory data.</td></tr>';
        }
    }

    function renderItems(page = 1) {
        itemCurrentPage = page;
        const tbody = document.getElementById('itemsTableBody');
        tbody.innerHTML = '';
        
        const searchVal = document.getElementById('modalItemSearch').value.toLowerCase();
        const filtered = currentModalItems.filter(i => {
            const num = (i.apparel_Number || i.Apparel_Number || "").toLowerCase();
            const status = (i.status || i.Status || "").toLowerCase();
            return status !== 'sold' && (num.includes(searchVal) || status.includes(searchVal));
        });

        document.getElementById('modalTotalItems').innerText = `Total: ${filtered.length} items`;
        
        const startIndex = (page - 1) * itemPageSize;
        const endIndex = startIndex + itemPageSize;
        const paginatedItems = filtered.slice(startIndex, endIndex);

        if (paginatedItems.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center" style="padding: 2rem;">No items found.</td></tr>';
            document.getElementById('modalPagination').innerHTML = '';
            return;
        }

        const apparelList = @Html.Raw(Json.Serialize(Model.Apparel));
        const parentItem = apparelList.find(i => i.apparel_ID === currentApparelId);

        paginatedItems.forEach(child => {
            const row = document.createElement('tr');
            const num = child.apparel_Number || child.Apparel_Number || "N/A";
            const stat = child.status || child.Status || "Unknown";
            const isSold = stat.toLowerCase() === 'sold';
            const itemId = child.id || child.Id;

            row.innerHTML = `
                <td><input type="checkbox" class="item-checkbox" data-id="${itemId}" onclick="updateBulkActions(event)" ${isSold ? 'disabled' : ''} /></td>
                <td><span class="serial-text">${num}</span></td>
                <td>
                    <div style="display: flex; flex-direction: column;">
                        <span style="font-weight: 700;">${parentItem.apparel_Name}</span>
                        <span style="font-size: 0.75rem; color: var(--text-muted);">${parentItem.sex} / Size ${parentItem.size}</span>
                    </div>
                </td>
                <td><span class="status-pill ${stat.toLowerCase().replace(' ', '-')}">${stat}</span></td>
                <td class="text-right">
                    <button class="btn-mini" style="background: rgba(16, 185, 129, 0.1); color: #10b981; border: none; padding: 0.4rem 0.8rem; border-radius: 8px; font-weight: 700; cursor: pointer; margin-right: 0.25rem;" 
                            onclick="showApparelTagModal('${itemId}', '${num}', '${stat}')">
                        <i class="fas fa-tag"></i>
                    </button>
                    <button class="btn-mini" style="background: ${isSold ? '#e2e8f0' : '#10b981'}; color: ${isSold ? '#94a3b8' : 'white'}; border: none; padding: 0.4rem 0.8rem; border-radius: 8px; font-weight: 700; cursor: ${isSold ? 'default' : 'pointer'};" 
                            onclick="markSingleAsSold(${itemId})" ${isSold ? 'disabled' : ''}>
                        <i class="fas fa-shopping-cart"></i> Sold
                    </button>
                </td>
            `;
            tbody.appendChild(row);
        });
        
        renderItemPagination(filtered.length);
    }

    function renderItemPagination(totalItems) {
        const totalPages = Math.ceil(totalItems / itemPageSize);
        const container = document.getElementById('modalPagination');
        container.innerHTML = '';
        
        if (totalPages <= 1) return;

        const btnStyle = "padding: 0.4rem 0.8rem; border-radius: 8px; border: 1px solid #e2e8f0; background: white; font-size: 0.75rem; font-weight: 700; cursor: pointer; transition: all 0.2s; margin: 0 2px;";
        const activeStyle = "background: var(--primary); color: white; border-color: var(--primary);";

        const createBtn = (page, text, active = false) => {
            const btn = document.createElement('button');
            btn.style.cssText = btnStyle + (active ? activeStyle : "");
            btn.innerText = text;
            btn.onclick = () => renderItems(page);
            return btn;
        };

        if (itemCurrentPage > 1) container.appendChild(createBtn(itemCurrentPage - 1, 'Prev'));
        
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= itemCurrentPage - 1 && i <= itemCurrentPage + 1)) {
                container.appendChild(createBtn(i, i, i === itemCurrentPage));
            } else if (i === itemCurrentPage - 2 || i === itemCurrentPage + 2) {
                const dot = document.createElement('span');
                dot.innerText = '...';
                container.appendChild(dot);
            }
        }

        if (itemCurrentPage < totalPages) container.appendChild(createBtn(itemCurrentPage + 1, 'Next'));
    }

    async function markSingleAsSold(itemId) {
        if (!confirm('Are you sure you want to mark this item as sold?')) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        try {
            const response = await fetch(`?handler=UpdateItemStatus&itemId=${itemId}&status=Sold`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });
            const result = await response.json();
            if (result.success) {
                // Remove item from the current list since it is now sold
                currentModalItems = currentModalItems.filter(i => i.id !== itemId);
                itemsChanged = true;
                showApToast('Sold', 'Item successfully marked as sold.', 'success');
                renderItems(itemCurrentPage);
            } else {
                showApToast('Error', result.message || 'Could not mark item as sold.', 'error');
            }
        } catch (e) {
            console.error(e);
            showApToast('Error', 'A network error occurred.', 'error');
        }
    }

    function filterModalItems() {
        renderItems(1);
    }

    function toggleSelectAll(master) {
        const checkboxes = document.querySelectorAll('.item-checkbox');
        checkboxes.forEach(cb => cb.checked = master.checked);
        updateBulkActions();
    }

    function updateBulkActions(event) {
        if(event) event.stopPropagation();
        const selectedCount = document.querySelectorAll('.item-checkbox:checked').length;
        const toolbar = document.getElementById('bulkActions');
        const countSpan = toolbar.querySelector('.selected-count');
        
        if (selectedCount > 0) {
            toolbar.style.display = 'flex';
            countSpan.innerText = `${selectedCount} item${selectedCount > 1 ? 's' : ''} selected`;
        } else {
            toolbar.style.display = 'none';
        }
    }

    function closeItemsModal() {
        document.getElementById('itemsModal').style.display = 'none';
        document.getElementById('modalItemSearch').value = '';
        document.getElementById('selectAllItems').checked = false;
        document.getElementById('bulkActions').style.display = 'none';

        if (itemsChanged) {
            showApToast('Updated', 'Inventory updated — refreshing list...', 'info');
            setTimeout(() => {
                const url = new URL(window.location.href);
                url.searchParams.set('showList', 'true');
                window.location.href = url.toString();
            }, 1200);
        }
    }

    async function openLogsModal() {
        document.getElementById('logsModal').style.display = 'flex';
        await fetchLogs(1);
    }

    function closeLogsModal() {
        document.getElementById('logsModal').style.display = 'none';
    }

    async function fetchLogs(page) {
        const tbody = document.getElementById('logsTableBody');
        tbody.innerHTML = '<tr><td colspan="5" class="text-center" style="padding: 2rem;"><i class="fas fa-spinner fa-spin"></i> Loading logs...</td></tr>';
        
        try {
            const response = await fetch(`?handler=Logs&page=${page}&pageSize=10`);
            const data = await response.json();
            
            renderLogsTable(data.logs);
            renderLogsPagination(data.page, data.totalPages);
        } catch (error) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger">Failed to load logs.</td></tr>';
        }
    }

    function renderLogsTable(logs) {
        const tbody = document.getElementById('logsTableBody');
        tbody.innerHTML = '';
        
        if (logs.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center">No activity logs found.</td></tr>';
            return;
        }

        logs.forEach(log => {
            const row = document.createElement('tr');
            const action = log.action.toLowerCase();
            const badgeStyle = action === 'register' ? 'background: rgba(16, 185, 129, 0.1); color: #10b981;' : 
                               (action === 'sold' ? 'background: rgba(99, 102, 241, 0.1); color: var(--primary);' : 
                                'background: rgba(100, 116, 139, 0.1); color: var(--text-muted);');
            
            row.innerHTML = `
                <td><small>${new Date(log.timestamp).toLocaleString()}</small></td>
                <td><span class="badge-glass" style="${badgeStyle} text-transform: uppercase; font-size: 0.65rem; padding: 0.25rem 0.6rem;">${log.action}</span></td>
                <td><strong>${log.entityName}</strong></td>
                <td><div style="max-width: 400px; font-size: 0.8rem; line-height: 1.4; color: var(--text-muted);">${log.details}</div></td>
                <td><small>${log.username || 'System'}</small></td>
            `;
            tbody.appendChild(row);
        });
    }

    function renderLogsPagination(currentPage, totalPages) {
        const container = document.getElementById('logsPagination');
        container.innerHTML = '';
        
        if (totalPages <= 1) return;

        const createBtn = (page, text, active = false) => {
            const btn = document.createElement('button');
            btn.className = 'btn-mini';
            if (active) {
                btn.style.background = 'var(--primary)';
                btn.style.color = 'white';
                btn.style.borderColor = 'var(--primary)';
            }
            btn.innerText = text;
            btn.onclick = () => fetchLogs(page);
            return btn;
        };

        if (currentPage > 1) container.appendChild(createBtn(currentPage - 1, 'Previous'));
        
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
                container.appendChild(createBtn(i, i, i === currentPage));
            } else if (i === currentPage - 2 || i === currentPage + 2) {
                const dot = document.createElement('span');
                dot.innerText = '...';
                dot.style.padding = '0 5px';
                container.appendChild(dot);
            }
        }

        if (currentPage < totalPages) container.appendChild(createBtn(currentPage + 1, 'Next'));
    }

    async function markSelectedAs(newStatus) {
        const checkboxes = document.querySelectorAll('.item-checkbox:checked');
        if (checkboxes.length === 0) return;
        
        // This function is now only used for batch processing or specific single updates
        // Most bulk status changes are removed per user request
    }

    function openAddStockModal() {
        document.getElementById('addStockModal').style.display = 'flex';
        document.getElementById('addStockQuantity').value = '1';
    }

    function closeAddStockModal() {
        document.getElementById('addStockModal').style.display = 'none';
    }

    async function submitAddStock() {
        const qty = parseInt(document.getElementById('addStockQuantity').value);
        if (isNaN(qty) || qty <= 0) {
            showApToast('Invalid', 'Please enter a valid quantity.', 'warning');
            return;
        }

        const btn = document.querySelector('#addStockModal .btn-premium');
        const originalContent = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<div class="btn-content"><i class="fas fa-spinner fa-spin"></i><span>Adding...</span></div>';

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const response = await fetch(`?handler=AddStock&id=${currentApparelId}&quantity=${qty}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                }
            });

            const result = await response.json();
            if (result.success) {
                showApToast('Stock Added', `Successfully added ${qty} item(s) to inventory.`, 'success');
                itemsChanged = true;
                closeAddStockModal();
                viewItems(currentApparelId); // Refresh items list
            } else {
                showApToast('Error', result.message || 'Failed to add stock.', 'error');
            }
        } catch (e) {
            console.error(e);
            showApToast('Error', 'A network error occurred.', 'error');
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalContent;
        }
    }

    // Product Tag Functionality
    let currentTagId = "";
    let currentTagNumber = "";
    let currentTagStatus = "";

    function showApparelTagModal(id, number, status) {
        currentTagId = id;
        currentTagNumber = number;
        currentTagStatus = status;

        const apparelList = @Html.Raw(Json.Serialize(Model.Apparel));
        const parent = apparelList.find(i => i.apparel_ID === currentApparelId);

        document.getElementById('tagModal').style.display = 'flex';
        document.getElementById('tagProductName').innerText = parent.apparel_Name;
        document.getElementById('tagProductSpec').innerText = `${parent.sex} / Size ${parent.size} / Grade ${parent.grade_Level}`;
        document.getElementById('tagId').innerText = `ID: ${number}`;
        
        const statusEl = document.getElementById('tagStatus');
        statusEl.innerText = status.toUpperCase();
        statusEl.className = `status-pill ${status.toLowerCase().replace(' ', '-')}`;

        document.getElementById('tagModalTitle').innerText = `Tag for ${number}`;
    }

    function closeTagModal() {
        document.getElementById('tagModal').style.display = 'none';
    }

    function downloadTagPdf() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        
        const apparelList = @Html.Raw(Json.Serialize(Model.Apparel));
        const parentItem = apparelList.find(i => i.apparel_ID === currentApparelId);
        
        generateOfficialTag(doc, 20, 20, parentItem, currentTagNumber, currentTagStatus);
        
        doc.save(`Official_Tag_${currentTagNumber}.pdf`);
    }

    function generateOfficialTag(doc, x, y, parent, number, status) {
        const width = 170;
        const height = 80;
        const centerX = x + (width / 2);

        // Border & Background
        doc.setDrawColor(16, 185, 129);
        doc.setLineWidth(1);
        doc.roundedRect(x, y, width, height, 8, 8);
        
        // Header Background
        doc.setFillColor(240, 253, 244);
        doc.roundedRect(x + 1, y + 1, width - 2, 15, 7, 7, 'F');

        // Institution Header
        doc.setFontSize(12);
        doc.setTextColor(5, 150, 105);
        doc.setFont(undefined, 'bold');
        doc.text("GOLDEN SUCCESS COLLEGE", centerX, y + 11, { align: "center" });
        
        // Product Name
        doc.setFontSize(22);
        doc.setTextColor(30, 41, 59);
        doc.text(parent.apparel_Name, centerX, y + 32, { align: "center" });
        
        // Specifications
        doc.setFontSize(11);
        doc.setFont(undefined, 'normal');
        doc.setTextColor(100, 116, 139);
        doc.text(`${parent.category} | ${parent.sex} | Size ${parent.size} | Grade ${parent.grade_Level}`, centerX, y + 42, { align: "center" });
        
        // Divider
        doc.setDrawColor(241, 245, 249);
        doc.line(x + 20, y + 50, x + 150, y + 50);

        // Unique ID
        doc.setFontSize(16);
        doc.setTextColor(99, 102, 241);
        doc.setFont(undefined, 'bold');
        doc.text(`IDENTITY ID: ${number}`, centerX, y + 62, { align: "center" });
        
        // Status Badge
        const isSold = status.toLowerCase() === 'sold';
        doc.setFillColor(isSold ? 16 : 99, isSold ? 185 : 102, isSold ? 129 : 241);
        doc.roundedRect(centerX - 25, y + 68, 50, 7, 2, 2, 'F');
        doc.setFontSize(9);
        doc.setTextColor(255, 255, 255);
        doc.text(status.toUpperCase(), centerX, y + 73, { align: "center" });
    }

    async function generateSelectedTagPdf() {
        const checkboxes = document.querySelectorAll('.item-checkbox:checked');
        if (checkboxes.length === 0) return;

        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        
        const apparelList = @Html.Raw(Json.Serialize(Model.Apparel));
        const parentItem = apparelList.find(i => i.apparel_ID === currentApparelId);
        
        let yPos = 10;
        let count = 0;

        for (const cb of checkboxes) {
            const itemId = cb.dataset.id;
            const item = currentModalItems.find(i => i.id == itemId);
            
            if (!item) continue;

            if (count > 0 && count % 3 === 0) {
                doc.addPage();
                yPos = 10;
            }

            generateOfficialTag(doc, 20, yPos, parentItem, item.apparel_Number, item.status);
            yPos += 90;
            count++;
        }
        
        doc.save(`Apparel_Batch_Tags_${parentItem.apparel_Name}.pdf`);
    }

    async function generateInventoryReport() {
        const btn = document.querySelector('button[onclick="generateInventoryReport()"]');
        const originalContent = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<div class="btn-content"><i class="fas fa-spinner fa-spin"></i><span>Generating...</span></div>';
 
        try {
            const response = await fetch(`?handler=ReportData&status=In Stock`);
            if (!response.ok) {
                const errorText = await response.text();
                console.error("Report Error:", errorText);
                alert('Failed to fetch report data.');
                return;
            }
            const items = await response.json();
 
            if (items.length === 0) {
                alert('No available items found.');
                return;
            }
 
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('l', 'mm', 'a4');
            
            // Header
            doc.setFontSize(22);
            doc.setTextColor(99, 102, 241);
            doc.setFont(undefined, 'bold');
            doc.text("GOLDEN SUCCESS COLLEGE", 14, 20);
            
            doc.setFontSize(14);
            doc.setTextColor(30, 41, 59);
            doc.text("Available Apparel Inventory Report", 14, 30);
            
            doc.setFontSize(10);
            doc.setTextColor(100, 116, 139);
            doc.setFont(undefined, 'normal');
            doc.text(`Total Records: ${items.length}`, 14, 38);
            doc.text(`Generated: ${new Date().toLocaleString()}`, 14, 44);
 
            const tableData = items.map(i => [
                i.apparel_Number || i.Apparel_Number || 'N/A',
                i.apparelType?.apparel_Name || i.ApparelType?.Apparel_Name || 'N/A',
                i.apparelType?.category || i.ApparelType?.Category || 'N/A',
                i.apparelType?.sex || i.ApparelType?.Sex || 'N/A',
                i.apparelType?.size || i.ApparelType?.Size || 'N/A',
                i.apparelType?.grade_Level || i.ApparelType?.Grade_Level || 'N/A',
                new Intl.NumberFormat('en-PH', { style: 'currency', currency: 'PHP' }).format(i.apparelType?.unit_Price || i.ApparelType?.Unit_Price || 0),
                new Date(i.lastModified || i.LastModified || new Date()).toLocaleDateString()
            ]);
 
            doc.autoTable({
                startY: 50,
                head: [['Serial #', 'Apparel Name', 'Category', 'Sex', 'Size', 'Grade', 'Unit Price', 'Last Updated']],
                body: tableData,
                theme: 'striped',
                headStyles: { fillColor: [99, 102, 241], textColor: 255, fontStyle: 'bold' },
                alternateRowStyles: { fillColor: [248, 250, 252] },
                margin: { top: 50 },
                styles: { font: 'helvetica', fontSize: 9 }
            });
 
            doc.save(`Available_Apparel_Report_${new Date().toISOString().split('T')[0]}.pdf`);
        } catch (e) {
            console.error(e);
            alert('Failed to generate report.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalContent;
        }
    }
 
    // Backdrop click
    window.onclick = function(e) {
        if (e.target.className === 'modal-overlay') {
            closeModal();
            closeItemsModal();
            closeLogsModal();
            closeTagModal();
            closeAddStockModal();
        }
    }
