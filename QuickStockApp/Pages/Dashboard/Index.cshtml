@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row mb-5 animate-in">
        <div class="col-12">
            <h1 class="fw-bold display-4" style="background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">@Model.CampusName</h1>
            <p class="text-muted fs-5"><i class="fas fa-chart-line me-2"></i>Dashboard Overview | Welcome back, Admin!</p>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-4 animate-in" style="animation-delay: 0.1s">
            <div class="glass-card text-center p-4">
                <div class="stat-icon-wrapper mb-3" style="background: rgba(99, 102, 241, 0.1); color: #6366f1;">
                    <i class="fas fa-boxes fa-2x"></i>
                </div>
                <h2 class="fw-bold mb-1">@Model.TotalAssets</h2>
                <p class="text-secondary fw-medium mb-0">Total IT Assets</p>
                <div class="mt-3 small text-success py-1 px-2 rounded-pill bg-success-light d-inline-block">
                    <i class="fas fa-arrow-up me-1"></i> Inventory Count
                </div>
            </div>
        </div>
        <div class="col-md-4 animate-in" style="animation-delay: 0.2s">
            <div class="glass-card text-center p-4">
                <div class="stat-icon-wrapper mb-3" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                    <i class="fas fa-door-open fa-2x"></i>
                </div>
                <h2 class="fw-bold mb-1">@Model.RoomCount</h2>
                <p class="text-secondary fw-medium mb-0">Active Rooms</p>
                <div class="mt-3 small text-primary py-1 px-2 rounded-pill bg-primary-light d-inline-block">
                    <i class="fas fa-map-marker-alt me-1"></i> Locations
                </div>
            </div>
        </div>
        <div class="col-md-4 animate-in" style="animation-delay: 0.3s">
            <div class="glass-card text-center p-4">
                <div class="stat-icon-wrapper mb-3" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                    <i class="fas fa-ban fa-2x"></i>
                </div>
                <h2 class="fw-bold mb-1">@Model.DisabledRooms</h2>
                <p class="text-secondary fw-medium mb-0">Disabled Rooms</p>
                <div class="mt-3 small text-danger py-1 px-2 rounded-pill bg-danger-light d-inline-block">
                    <i class="fas fa-exclamation-triangle me-1"></i> Out of Service
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Row -->
    <div class="row g-4">
        <!-- Activity Feed -->
        <div class="col-lg-8 animate-in" style="animation-delay: 0.4s">
            <div class="glass-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">Recent Activity</h5>
                    <button class="btn btn-sm btn-link text-decoration-none" onclick="showLogs()">View Logs</button>
                </div>
                <div class="table-responsive">
                    <table class="table table-borderless align-middle">
                        <thead class="text-muted small">
                            <tr>
                                <th>ACTION</th>
                                <th>ENTITY</th>
                                <th>USER</th>
                                <th>TIME</th>
                                <th class="text-end">DETAILS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Activities.Any())
                            {
                                @foreach (var activity in Model.Activities)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge rounded-pill bg-light text-dark p-2 px-3 border">
                                                @activity.Action
                                            </span>
                                        </td>
                                        <td class="fw-medium">@activity.EntityName</td>
                                        <td class="small">@activity.Username</td>
                                        <td class="text-muted small">@activity.Timestamp</td>
                                        <td class="text-end small text-muted">@activity.Details</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No recent activity found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="col-lg-4 animate-in" style="animation-delay: 0.5s">
            <div class="glass-card h-100">
                <h5 class="fw-bold mb-4">Quick Actions</h5>
                <div class="d-grid gap-3">
                    @* Add New Product Removed *@
                    <a asp-page="/ItAssets" asp-route-triggerReport="true" class="btn btn-outline-dark d-flex align-items-center justify-content-between p-3 rounded-4">
                        <span>Generate Report</span>
                        <span>📊</span>
                    </a>
                    <button onclick="openSettings()" class="btn btn-outline-dark d-flex align-items-center justify-content-between p-3 rounded-4">
                        <span>Settings</span>
                        <span>⚙️</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Audit Logs Modal -->
    <div id="logsModal" class="modal-overlay" style="display: none;">
        <div class="modal-content glass-panel animate-in" style="max-width: 900px;">
            <div class="modal-header">
                <h2 class="premium-title fs-3">System Audit Logs</h2>
                <button class="close-btn" onclick="closeLogs()">&times;</button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="text-secondary small">
                            <tr>
                                <th>ACTION</th>
                                <th>ENTITY</th>
                                <th>USER</th>
                                <th>TIME</th>
                                <th>DETAILS</th>
                            </tr>
                        </thead>
                        <tbody id="logsTableBody">
                            <!-- Loaded via JS -->
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <span id="pageInfo" class="small text-muted">Page 1</span>
                    <div class="pagination-btns">
                        <button class="btn btn-sm btn-outline-dark me-2" id="prevBtn" onclick="changePage(-1)" disabled>Previous</button>
                        <button class="btn btn-sm btn-outline-dark" id="nextBtn" onclick="changePage(1)">Next</button>
                    </div>
                </div>
            </div>
        </div>
</div>

<style>
    .stat-icon-wrapper {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        transition: all 0.3s ease;
    }
    
    .glass-card:hover .stat-icon-wrapper {
        transform: scale(1.1);
    }

    .bg-success-light { background-color: rgba(16, 185, 129, 0.1); color: #10b981; }
    .bg-primary-light { background-color: rgba(99, 102, 241, 0.1); color: #6366f1; }
    .bg-danger-light { background-color: rgba(239, 68, 68, 0.1); color: #ef4444; }

    .animate-in {
        animation: slideUp 0.5s ease-out forwards;
        opacity: 0;
    }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 2000; }
    .glass-panel { background: rgba(255, 255, 255, 0.9); border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.3); padding: 2rem; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1); }
    .close-btn { position: absolute; top: 1.5rem; right: 1.5rem; border: none; background: transparent; font-size: 1.5rem; cursor: pointer; color: #64748b; }
</style>

<script>
    let currentPage = 1;
    let totalPages = 1;
    const pageSize = 5;
    const campusId = "@User.FindFirst("ActiveCampusId")?.Value";

    async function showLogs() {
        document.getElementById('logsModal').style.display = 'flex';
        currentPage = 1;
        await loadLogs();
    }

    function closeLogs() {
        document.getElementById('logsModal').style.display = 'none';
    }

    async function loadLogs() {
        const tableBody = document.getElementById('logsTableBody');
        tableBody.innerHTML = '<tr><td colspan="5" class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div> Loading...</td></tr>';
        
        try {
            const url = `?handler=Logs&page=${currentPage}&pageSize=${pageSize}`;
            const response = await fetch(url);
            if (response.ok) {
                const data = await response.json();
                totalPages = data.totalPages;
                renderLogs(data.logs);
            } else {
                tableBody.innerHTML = '<tr><td colspan="5" class="text-center text-danger py-4">Failed to load logs.</td></tr>';
            }
        } catch (error) {
            tableBody.innerHTML = '<tr><td colspan="5" class="text-center text-danger py-4">Error connecting to server.</td></tr>';
        }
    }

    function renderLogs(logs) {
        const tableBody = document.getElementById('logsTableBody');
        tableBody.innerHTML = logs.map(log => `
            <tr>
                <td><span class="badge rounded-pill bg-light text-dark border">${log.action}</span></td>
                <td class="fw-medium">${log.entityName}</td>
                <td>${log.username}</td>
                <td class="small text-muted">${new Date(log.timestamp).toLocaleString()}</td>
                <td class="small text-muted">${log.details}</td>
            </tr>
        `).join('');

        if (logs.length === 0 && currentPage === 1) {
            tableBody.innerHTML = '<tr><td colspan="5" class="text-center py-4">No logs found.</td></tr>';
        }

        document.getElementById('pageInfo').innerText = `Page ${currentPage} of ${totalPages || 1}`;
        document.getElementById('prevBtn').disabled = currentPage === 1;
        document.getElementById('nextBtn').disabled = currentPage >= totalPages;
    }

    async function changePage(delta) {
        currentPage += delta;
        await loadLogs();
    }

    // Close on backdrop click
    window.onclick = function(event) {
        const modal = document.getElementById('logsModal');
        if (event.target == modal) closeLogs();
    }
</script>
