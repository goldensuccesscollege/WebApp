@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="container-fluid py-4">
    <div class="row mb-4 animate-in">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <div class="d-flex align-items-center gap-3 mb-1">
                        <h1 class="fw-bold mb-0" style="font-size:2rem; color: #1F3C88;">
                            <i class="fas fa-school me-2"></i>GSC — Cebu Overview
                        </h1>
                        <span class="badge rounded-pill px-3 py-2" style="background: linear-gradient(135deg,#1F3C88,#6366f1); color:#fff; font-size:0.75rem; letter-spacing:0.03em;">
                            <i class="fas fa-university me-1"></i>@Model.CampusName
                        </span>
                    </div>
                    <p class="text-muted mb-0">Welcome back, <strong>@User.Identity?.Name</strong>! Here's your inventory at a glance.</p>
                </div>
                <span class="badge rounded-pill px-4 py-2 fs-6" style="background: rgba(31,60,136,0.1); color: #1F3C88; border: 1.5px solid rgba(31,60,136,0.2);">
                    <i class="fas fa-clock me-1"></i> @DateTime.Now.ToString("MMM dd, yyyy")
                </span>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">

        <partial name="_ItAssetsCard" model="Model" />

        <partial name="_ApparelCard" model="Model" />

        <partial name="_HomeEconomicsCard" model="Model" />

        <partial name="_ConsumablesCard" model="Model" />

    </div>
</div>

<div id="logsModal" class="modal-overlay" style="display: none;">
    <div class="modal-content glass-panel animate-in" style="max-width: 900px; width: 95%;">
        <div class="modal-header d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0" id="logsModalTitle" style="color: #1e293b;"><i class="fas fa-clipboard-list me-2 text-primary"></i>Audit Logs</h5>
            <button class="btn-close" onclick="closeLogs()"></button>
        </div>
        <div class="modal-body p-0">
            <div class="table-responsive" style="max-height: 55vh; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Status</th>
                            <th>Type</th>
                            <th>User</th>
                            <th>Time</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody id="logsTableBody"></tbody>
                </table>
            </div>
        </div>
        <div class="modal-footer-custom d-flex justify-content-between align-items-center">
            <span id="pageInfo" class="small fw-bold text-secondary">Page 1</span>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" id="prevBtn" onclick="changePage(-1)" disabled>
                    <i class="fas fa-chevron-left me-1"></i> Previous
                </button>
                <button class="btn btn-sm btn-primary rounded-pill px-4" id="nextBtn" onclick="changePage(1)">
                    Next <i class="fas fa-chevron-right ms-1"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 23, 42, 0.4);
        backdrop-filter: blur(8px);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: fadeIn 0.3s ease;
    }

    .modal-content.glass-panel {
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 24px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        overflow: hidden;
    }

    .modal-header {
        padding: 1.5rem 2rem;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        background: rgba(255,255,255,0.5);
    }

    .modal-footer-custom {
        padding: 1.25rem 2rem;
        background: #f8fafc;
        border-top: 1px solid #f1f5f9;
    }

    .table thead th {
        background: #f8fafc;
        color: #64748b;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 700;
        border-top: none;
        padding: 1rem;
    }

    .table td {
        padding: 1rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .animate-in {
        animation: slideUp 0.4s ease-out forwards;
    }

    /* LABEL: Solved keyframes breaking context error by using escape sequence '@@' */
    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .bg-primary-gradient {
        background: linear-gradient(135deg, #1F3C88 0%, #4f46e5 100%);
    }

    .bg-success-gradient {
        background: linear-gradient(135deg, #2E7D32 0%, #22c55e 100%);
    }

    .bg-warning-gradient {
        background: linear-gradient(135deg, #b45309 0%, #f59e0b 100%);
    }

    .bg-consumables-gradient {
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    }

    .letter-spacing-05 {
        letter-spacing: 0.05em;
    }

    .line-height-1 {
        line-height: 1;
    }

    .fw-extrabold {
        font-weight: 900;
    }

    .transform-translate-x-hover {
        transition: transform 0.3s ease;
    }

    .group:hover .transform-translate-x-hover {
        transform: translateX(5px);
    }

    .group-hover-opacity-100 {
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .group:hover .group-hover-opacity-100 {
        opacity: 1;
    }

    .text-indigo {
        color: #6366f1;
    }

    .dash-stat-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        background: rgba(255,255,255,0.85);
        border: 1.5px solid rgba(99,102,241,0.08);
        border-radius: 18px;
        padding: 1.1rem 1.3rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        transition: all 0.25s ease;
        cursor: pointer;
        position: relative;
    }

        .dash-stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(99,102,241,0.13);
            border-color: #6366f1;
        }

    .dash-stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: transform 0.25s;
    }

    .dash-stat-card:hover .dash-stat-icon {
        transform: scale(1.12);
    }

    .dash-stat-value {
        font-size: 1.7rem;
        font-weight: 800;
        color: #1e293b;
        line-height: 1;
    }

    .dash-stat-label {
        font-size: 0.8rem;
        color: #64748b;
        font-weight: 700;
        margin-top: 2px;
        text-transform: uppercase;
    }

    .dash-stat-arrow {
        margin-left: auto;
        color: #1F3C88;
        opacity: 0.6;
    }

    .activity-list {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        max-height: 220px;
        overflow-y: auto;
        padding-right: 5px;
    }

        .activity-list::-webkit-scrollbar {
            width: 4px;
        }

        .activity-list::-webkit-scrollbar-track {
            background: transparent;
        }

        .activity-list::-webkit-scrollbar-thumb {
            background: rgba(0,0,0,0.1);
            border-radius: 4px;
        }

    .activity-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.55rem 0.8rem;
        border-radius: 10px;
        background: rgba(31, 60, 136, 0.04);
        border: 1px solid rgba(31, 60, 136, 0.08);
        transition: background 0.2s;
    }

        .activity-item:hover {
            background: rgba(31, 60, 136, 0.09);
        }

    .activity-badge {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        white-space: nowrap;
    }

    .it-badge {
        background: rgba(31, 60, 136, 0.1);
        color: #1F3C88;
    }

    .ap-badge {
        background: rgba(46, 125, 50, 0.1);
        color: #2E7D32;
    }

    .activity-info {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

        .activity-info span {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .table tbody tr:hover {
        background: rgba(99, 102, 241, 0.02);
    }

    body.dark-mode .dash-stat-card {
        background: rgba(30,41,59,0.85) !important;
    }

    .dash-panel-left {
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
    }

    .dash-panel-left:hover {
        filter: brightness(1.1) contrast(1.02);
        box-shadow: inset 0 0 100px rgba(255, 255, 255, 0.08) !important;
    }
</style>



@section Scripts {
    <script>
        @{
            var jsonOpts = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
        }

        // LABEL: Wrapped inside string quotes and JSON.parse() to completely stop JavaScript expression warnings
        const assetsByStatus  = JSON.parse('@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AssetsByStatus, jsonOpts))') || [];
        const assetsByType    = JSON.parse('@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AssetsByType, jsonOpts))') || [];
        const apparelByCat    = JSON.parse('@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApparelByCategory, jsonOpts))') || [];
        const furnitureByCond = JSON.parse('@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FurnitureByCondition, jsonOpts))') || [];

        const apparelStock   = { inStock: @Model.TotalApparelInStock, sold: @Model.TotalApparelSold };
        const campusId        = "@User.FindFirst("ActiveCampusId")?.Value";

        const PALETTE = ['#1F3C88', '#F4C430', '#D62828', '#2E7D32', '#6366f1', '#64748b'];

        const chartOptions = {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '75%',
            plugins: {
                legend: {
                    position: 'right',
                    labels: { padding: 15, usePointStyle: true, pointStyle: 'circle', font: { size: 11, weight: '600' } }
                }
            }
        };

        // 1. IT Assets Chart Engine
        const itChartEl = document.getElementById('itAssetsChartCombined');
        if (itChartEl && assetsByStatus.length) {
            new Chart(itChartEl, {
                type: 'doughnut',
                data: {
                    labels: assetsByStatus.map(x => x.status),
                    datasets: [{ data: assetsByStatus.map(x => x.count), backgroundColor: PALETTE, borderWidth: 0, hoverOffset: 15 }]
                },
                options: chartOptions
            });
        }

        // 2. Apparel Chart Engine
        const apChartEl = document.getElementById('apparelChartCombined');
        if (apChartEl && apparelByCat.length) {
            new Chart(apChartEl, {
                type: 'doughnut',
                data: {
                    labels: apparelByCat.map(x => x.category),
                    datasets: [{ data: apparelByCat.map(x => x.count), backgroundColor: PALETTE, borderWidth: 0, hoverOffset: 15 }]
                },
                options: chartOptions
            });
        }

        // 3. Home Economics Chart Engine
        const heChartEl = document.getElementById('furnitureChartOnly');
        if (heChartEl) {
            let labels = [];
            let data = [];
            let colors = [];

            if (furnitureByCond.length) {
                furnitureByCond.forEach(x => {
                    labels.push(`Furniture: ${x.condition}`);
                    data.push(x.count);
                    colors.push(x.condition === 'Good' ? '#10b981' : x.condition === 'Fair' ? '#f59e0b' : '#ef4444');
                });
            }

            if (apparelStock.inStock > 0) {
                 const totalConsumableTypes = @Model.TotalConsumableTypes;
                 if (totalConsumableTypes > 0) {
                     labels.push('Consumable Types');
                     data.push(totalConsumableTypes);
                     colors.push('#6366f1');
                 }
            }

            if (labels.length) {
                new Chart(heChartEl, {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{ data: data, backgroundColor: colors, borderWidth: 0, hoverOffset: 15 }]
                    },
                    options: chartOptions
                });
            }
        }

        // ==========================================
        // BACKEND AJAX AUDIT ENGINE LOGIC
        // ==========================================
        let currentLogType = '';
        let currentLogPage = 1;
        const LOG_PAGE_SIZE = 10;

        async function showLogs(entityType) {
            currentLogType = entityType;
            currentLogPage = 1;

            const titleEl = document.getElementById('logsModalTitle');
            if (entityType === 'ItAsset') titleEl.innerHTML = '<i class="fas fa-desktop me-2 text-primary"></i>IT Asset Audit Logs';
            else if (entityType === 'Apparel') titleEl.innerHTML = '<i class="fas fa-tshirt me-2 text-success"></i>Apparel Audit Logs';
            else if (entityType === 'Furniture') titleEl.innerHTML = '<i class="fas fa-chair me-2 text-warning"></i>Furniture Audit Logs';
            else if (entityType === 'Consumable') titleEl.innerHTML = '<i class="fas fa-box-open me-2 text-indigo"></i>Consumables Audit Logs';
            else titleEl.innerHTML = '<i class="fas fa-history me-2 text-secondary"></i>System Audit Logs';

            document.getElementById('logsModal').style.display = 'flex';
            await fetchLogData();
        }

        function closeLogs() {
            document.getElementById('logsModal').style.display = 'none';
        }

        async function changePage(direction) {
            currentLogPage += direction;
            await fetchLogData();
        }

        async function fetchLogData() {
            const tableBody = document.getElementById('logsTableBody');
            tableBody.innerHTML = '<tr><td colspan="7" class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Loading logs stream...</td></tr>';

            try {
                const response = await fetch(`?handler=Logs&page=${currentLogPage}&pageSize=${LOG_PAGE_SIZE}&entityType=${currentLogType}`);
                if (!response.ok) throw new Error("Connection failed.");

                const data = await response.json();
                const logs = data.items || data || [];
                tableBody.innerHTML = '';

                if (logs.length === 0) {
                    tableBody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">No operational history logs found.</td></tr>';
                    document.getElementById('nextBtn').disabled = true;
                    return;
                }

                logs.forEach(log => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td><span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1 small fw-bold text-uppercase">${log.action || 'Log'}</span></td>
                        <td class="fw-bold text-dark">${log.entityName || 'N/A'}</td>
                        <td><span class="text-success small"><i class="fas fa-check-circle me-1"></i>Success</span></td>
                        <td><small class="text-muted text-uppercase font-monospace" style="font-size:0.7rem;">${log.entityType || currentLogType}</small></td>
                        <td><span class="badge rounded-pill bg-light text-dark border px-2.5">${log.username || 'System'}</span></td>
                        <td><small class="text-muted">${log.timestamp || 'Just now'}</small></td>
                        <td><button class="btn btn-xs btn-outline-primary py-0 px-2 fs-7 rounded" onclick="alert('Details: ${log.details || 'No data edits.'}')">View</button></td>
                    `;
                    tableBody.innerHTML += tr.outerHTML;
                });

                document.getElementById('pageInfo').innerText = `Page ${currentLogPage}`;
                document.getElementById('prevBtn').disabled = (currentLogPage === 1);
                document.getElementById('nextBtn').disabled = (logs.length < LOG_PAGE_SIZE);

            } catch (err) {
                console.error(err);
                tableBody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-danger"><i class="fas fa-exclamation-triangle me-2"></i>Failed to render data stream.</td></tr>';
            }
        }

        window.onclick = function(event) {
            const modal = document.getElementById('logsModal');
            if (event.target === modal) closeLogs();
        }
    </script>
}