@page
@model QuickStockApp.Pages.RoomsModel
@{
    ViewData["Title"] = "Room Management";
}

<div class="rooms-container fade-in">
    <div class="header-section">
        <div class="header-content">
            <h1 class="premium-title">Room Management</h1>
            <p class="subtitle">Organize and manage your facility locations.</p>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Admin"))
            {
                <a asp-page="/Admin/DisabledRooms" class="btn btn-outline-danger animate-in" style="border-radius: 12px; font-weight: 600; display: flex; align-items: center; gap: 0.5rem; transition: all 0.3s; border-width: 2px;">
                    <i class="fas fa-ban"></i> Manage Disabled Rooms
                </a>
            }
            <button class="add-btn animate-in" onclick="openRoomModal()">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Add New Room
            </button>
        </div>
    </div>

    <div class="active-rooms-section mb-5 animate-in">
        <div class="section-header mb-3">
            <h2 class="section-title"><i class="fas fa-check-circle me-2 text-success"></i> Active Rooms</h2>
        </div>
        <div class="table-container glass-panel">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th>Room Name</th>
                        <th>Floor</th>
                        <th>Description</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rooms.Any(r => !r.IsDisabled))
                    {
                        @foreach (var room in Model.Rooms.Where(r => !r.IsDisabled))
                        {
                            <tr class="room-row active-room clickable-row" onclick="viewAssets(@room.RoomId)">
                                <td>
                                    <div class="room-name-cell">
                                        <div class="room-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                                        </div>
                                        <span class="room-name">@room.RoomName</span>
                                    </div>
                                </td>
                                <td><span class="floor-badge">@room.RoomFloor</span></td>
                                <td><span class="description-text">@room.RoomDescription</span></td>
                                <td class="text-right" onclick="event.stopPropagation()">
                                    <div class="action-btns">
                                        <button class="icon-btn edit-btn" 
                                                data-id="@room.RoomId"
                                                data-name="@room.RoomName"
                                                data-floor="@room.RoomFloor"
                                                data-desc="@room.RoomDescription"
                                                data-campusid="@room.CampusId"
                                                onclick="editRoom(this)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                        </button>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <form asp-page-handler="ToggleStatus" asp-route-roomId="@room.RoomId" method="post" style="display:inline;">
                                                <button type="submit" class="icon-btn toggle-btn" title="Disable Room">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                                                </button>
                                            </form>
                                            <form asp-page-handler="Delete" asp-route-id="@room.RoomId" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this room?');">
                                                <button type="submit" class="icon-btn delete-btn">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="fas fa-info-circle fa-2x mb-3 d-block"></i>
                                No active rooms found. Add a room to get started!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

<!-- Room Modal -->
<div id="roomModal" class="modal">
    <div class="modal-content glass-panel animate-in">
        <div class="modal-header">
            <h2 id="modalTitle">Add New Room</h2>
            <button class="close-btn" onclick="closeModal()">&times;</button>
        </div>
        <form id="roomForm" method="post">
            <input type="hidden" asp-for="Room.RoomId" id="roomId" />
            
            @{
                var activeCampusId = User.FindFirst("ActiveCampusId")?.Value;
                bool hideCampusSelect = !string.IsNullOrEmpty(activeCampusId);
            }

            <div class="modal-body">
                @if (Model.AssignedCampuses.Count > 1 && !hideCampusSelect)
                {
                    <div class="form-group">
                        <label asp-for="Room.CampusId">Campus</label>
                        <select asp-for="Room.CampusId" id="campusIdInput" required>
                            <option value="">Select Campus</option>
                            @foreach (var campus in Model.AssignedCampuses)
                            {
                                <option value="@campus.CampusId">@campus.Name</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <input type="hidden" asp-for="Room.CampusId" id="campusIdInput" value="@activeCampusId" />
                }
                <div class="form-group">
                    <label asp-for="Room.RoomName">Room Name</label>
                    <input asp-for="Room.RoomName" id="name" placeholder="e.g., Room 403" required />
                </div>
                <div class="form-group">
                    <label asp-for="Room.RoomFloor">Floor</label>
                    <select asp-for="Room.RoomFloor" id="floor" required>
                        <option value="">Select Floor</option>
                        <option value="1st Floor">1st Floor</option>
                        <option value="2nd Floor">2nd Floor</option>
                        <option value="3rd Floor">3rd Floor</option>
                        <option value="4th Floor">4th Floor</option>
                        <option value="5th Floor">5th Floor</option>
                        <option value="6th Floor">6th Floor</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="Room.RoomDescription">Description</label>
                    <textarea asp-for="Room.RoomDescription" id="desc" rows="3" placeholder="Additional details..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="cancel-btn" onclick="closeModal()">Cancel</button>
                <button type="submit" id="submitBtn" class="submit-btn">Add Room</button>
            </div>
        </form>
    </div>
</div>

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        --glass-bg: rgba(255, 255, 255, 0.7);
        --glass-border: rgba(255, 255, 255, 0.3);
        --text-dark: #1e293b;
        --accent-color: #6366f1;
        --danger-color: #ef4444;
    }

    .rooms-container {
        padding: 2rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .header-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 3rem;
    }

    .premium-title {
        font-size: 2.5rem;
        font-weight: 800;
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.5rem;
    }

    .subtitle {
        color: #64748b;
        font-size: 1.1rem;
    }

    .add-btn {
        background: var(--primary-gradient);
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
    }

    .add-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
    }

    .glass-panel {
        background: var(--glass-bg);
        backdrop-filter: blur(12px);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
    }

    .table-container {
        overflow: hidden;
    }

    .premium-table {
        width: 100%;
        border-collapse: collapse;
    }

    .premium-table th {
        text-align: left;
        padding: 1.5rem;
        color: #64748b;
        font-weight: 600;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }

    .premium-table td {
        padding: 1.25rem 1.5rem;
        color: var(--text-dark);
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }

    .clickable-row {
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .clickable-row:hover {
        background: rgba(99, 102, 241, 0.08) !important;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.1);
    }

    .room-name-cell {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .room-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: rgba(99, 102, 241, 0.1);
        color: var(--accent-color);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .room-name {
        font-weight: 600;
    }

    .floor-badge {
        background: #f1f5f9;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 500;
        color: #475569;
    }

    .action-btns {
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
    }

    .icon-btn {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: 1px solid var(--glass-border);
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        color: #64748b;
    }

    .edit-btn:hover {
        background: var(--accent-color);
        color: white;
        border-color: var(--accent-color);
    }

    .delete-btn:hover {
        background: var(--danger-color);
        color: white;
        border-color: var(--danger-color);
    }

    .toggle-btn:hover.disabled {
        background: #f59e0b;
        color: white;
        border-color: #f59e0b;
    }

    .toggle-btn:hover.enabled {
        background: #10b981;
        color: white;
        border-color: #10b981;
    }

    .status-badge {
        font-size: 0.7rem;
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
        font-weight: 700;
        text-transform: uppercase;
        margin-left: 0.5rem;
    }

    .status-badge.disabled {
        background: #fee2e2;
        color: #ef4444;
    }

    .animate-pulse {
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: .5; }
    }

    .text-right { text-align: right; }

    /* Modal Styles */
    .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(4px);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

    .modal-content {
        width: 100%;
        max-width: 500px;
        margin: 1.5rem;
    }

    .modal-header {
        padding: 1.5rem;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .close-btn {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #64748b;
    }

    .modal-body {
        padding: 1.5rem;
    }

    .form-group {
        margin-bottom: 1.25rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 600;
        color: var(--text-dark);
    }

    .form-group input, .form-group textarea {
        width: 100%;
        padding: 0.75rem;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        transition: all 0.3s;
    }

    .form-group input:focus, .form-group textarea:focus {
        border-color: var(--accent-color);
        outline: none;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }

    .modal-footer {
        padding: 1.5rem;
        border-top: 1px solid rgba(0,0,0,0.05);
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
    }

    .cancel-btn {
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        background: white;
        font-weight: 600;
        cursor: pointer;
    }

    .submit-btn {
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
        border: none;
        background: var(--primary-gradient);
        color: white;
        font-weight: 600;
        cursor: pointer;
    }

    /* Tabs Styles */
    .tabs-container {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
        border-bottom: 2px solid rgba(0,0,0,0.05);
        padding-bottom: 0.5rem;
    }

    .tab-btn {
        background: none;
        border: none;
        padding: 0.75rem 1.25rem;
        font-weight: 600;
        color: #64748b;
        cursor: pointer;
        border-radius: 12px;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        position: relative;
    }

    .tab-btn:hover {
        background: rgba(99, 102, 241, 0.05);
        color: var(--accent-color);
    }

    .tab-btn.active {
        background: var(--primary-gradient);
        color: white;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
    }

    .tab-btn .badge {
        margin-left: 0.5rem;
        background: rgba(0,0,0,0.1);
        padding: 0.1rem 0.6rem;
        border-radius: 20px;
        font-size: 0.75rem;
    }

    .tab-btn.active .badge {
        background: rgba(255,255,255,0.2);
    }

    .disabled-room {
        background: rgba(241, 245, 249, 0.5);
    }

    .disabled-room td {
        opacity: 0.8;
    }

    .status-badge.disabled {
        background: #fef2f2;
        color: #ef4444;
        border: 1px solid #fee2e2;
        font-size: 0.7rem;
        padding: 2px 8px;
        border-radius: 20px;
        margin-left: 8px;
    }

    .action-btns .toggle-btn.enabled {
        color: #10b981;
    }

    .action-btns .toggle-btn.enabled:hover {
        background: rgba(16, 185, 129, 0.1);
    }

    .action-btns .toggle-btn.disabled {
        color: #f59e0b;
    }

    .action-btns .toggle-btn.disabled:hover {
        background: rgba(245, 158, 11, 0.1);
    }

    .premium-badge-btn {
        padding: 0.5rem 1rem;
        border-radius: 20px;
        border: none;
        font-weight: 600;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .enable-btn {
        background: #10b981;
        color: white;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
    }

    .enable-btn:hover {
        background: #059669;
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(16, 185, 129, 0.3);
    }

    .animate-in {
        animation: slideUp 0.5s ease-out forwards;
    }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<script>
    // Initialize display based on role
    document.addEventListener('DOMContentLoaded', () => {
        // State is handled server-side
    });

    function openRoomModal() {
        const modal = document.getElementById('roomModal');
        modal.style.display = 'flex';
        document.getElementById('modalTitle').innerText = 'Add New Room';
        
        const form = document.getElementById('roomForm');
        const activeCampusId = "@(User.FindFirst("ActiveCampusId")?.Value)";
        
        form.reset();
        form.action = '?handler=Add';
        
        document.getElementById('roomId').value = '0';
        document.getElementById('submitBtn').innerText = 'Add Room';
        
        // Restore active campus if context is locked
        if (activeCampusId) {
            const campusInput = document.getElementById('campusIdInput');
            if (campusInput) campusInput.value = activeCampusId;
        }
    }

    function editRoom(btn) {
        const data = btn.dataset;
        document.getElementById('roomModal').style.display = 'flex';
        document.getElementById('modalTitle').innerText = 'Edit Room';
        document.getElementById('roomForm').action = '?handler=Update';
        document.getElementById('submitBtn').innerText = 'Update Room';

        document.getElementById('roomId').value = data.id || "0";
        document.getElementById('name').value = data.name || "";
        document.getElementById('floor').value = data.floor || "";
        document.getElementById('description').value = data.desc || "";
        
        const campusInput = document.getElementById('campusIdInput');
        if (campusInput) campusInput.value = data.campusid || "";

        document.getElementById('submitBtn').innerText = 'Update Room';
    }

    function closeModal() {
        document.getElementById('roomModal').style.display = 'none';
    }

    function viewAssets(roomId) {
        window.location.href = `/ItAssets?SelectedRoomId=${roomId}`;
    }

    // Close modal on click outside
    window.onclick = function(event) {
        if (event.target == document.getElementById('roomModal')) {
            closeModal();
        }
    }
</script>
